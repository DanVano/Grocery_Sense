@page "/deals"
@using GrocerySense.Core
@using GrocerySense.Data
@using GrocerySense.Data.Repositories
@using GrocerySense.Domain
@implements IDisposable
@inject SqliteConnectionFactory Db
@inject PreferencesService Prefs
@inject FlyerSyncScheduler Sync
@inject MultiBuyDealService MultiBuy

<MudText Typo="Typo.h5" GutterBottom="true">Deals</MudText>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SyncAsync" Disabled="@_syncing">
        Sync flyers
    </MudButton>
    @if (_syncing)
    {
        <MudButton Variant="Variant.Text" OnClick="CancelSync">Cancel</MudButton>
        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Syncing" />
    }
</MudStack>

@if (_syncMessage is not null)
{
    <MudAlert Class="mb-2" Severity="@_syncSeverity" Dense="true">@_syncMessage</MudAlert>
}
@if (_error is not null)
{
    <MudAlert Class="mb-2" Severity="Severity.Error">@_error</MudAlert>
}

@if (_dealsByStore is null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" aria-label="Loading" />
    </div>
}
else if (_dealsByStore.Count == 0)
{
    <MudText Typo="Typo.body2">
        No active deals. Flyer deals appear here after a flyer ingest or provider sync
        (no deal provider is connected yet).
    </MudText>
}
else
{
    @if (_hiddenHardExcluded > 0)
    {
        <MudText Typo="Typo.caption" Class="mb-1">
            @_hiddenHardExcluded deal(s) hidden by household hard-excludes.
        </MudText>
    }
    @foreach (var group in _dealsByStore)
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <MudText Typo="Typo.subtitle1">@group.StoreName</MudText>
            <MudList T="int" Dense="true">
                @foreach (var deal in group.Deals)
                {
                    <MudListItem T="int">
                        <MudText Typo="Typo.body2">
                            @DealLabel(deal.Row)
                            @if (deal.EffectiveUnit is double eff)
                            {
                                <span> = $@eff.ToString("0.00") ea</span>
                            }
                            @if (deal.EffectiveUnit is double e && deal.UsualPrice is double usual)
                            {
                                @if (usual > 0 && (usual - e) / usual * 100.0 >= VerdictBelowUsualPct)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                        ↓ @(((usual - e) / usual * 100.0).ToString("0"))% vs usual
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default">≈ usual — skip</MudChip>
                                }
                            }
                            @if (deal.SoftExcluded)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">avoid</MudChip>
                            }
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }
}

@code {
    private sealed record DealView(FlyerDeal Row, bool SoftExcluded, double? EffectiveUnit, double? UsualPrice);
    private sealed record StoreDeals(string StoreName, IReadOnlyList<DealView> Deals);

    // Verdict chip threshold: an effective price less than this % below usual reads "≈ usual — skip".
    private const double VerdictBelowUsualPct = 5.0;

    private IReadOnlyList<StoreDeals>? _dealsByStore;
    private int _hiddenHardExcluded;
    private string? _error;
    private bool _syncing;
    private string? _syncMessage;
    private Severity _syncSeverity = Severity.Info;
    private CancellationTokenSource? _syncCts;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private static string DealLabel(FlyerDeal d)
    {
        var title = d.Title is { Length: > 0 } t ? t : d.Description is { Length: > 0 } de ? de : "(untitled)";
        var price = d.PriceText is { Length: > 0 } pt ? pt
            : d.UnitPrice is decimal up ? $"${up:0.00}{(d.Unit is { Length: > 0 } u ? $"/{u}" : "")}"
            : null;
        return price is null ? title : $"{title} — {price}";
    }

    private async Task ReloadAsync()
    {
        try
        {
            _error = null;
            var (groups, hidden) = await Task.Run(() =>
            {
                var eff = Prefs.ComputeEffectivePreferences();
                using var conn = Db.Open();
                var storeNames = StoresRepo.ListStores(conn).ToDictionary(s => s.Id, s => s.Name);
                var deals = new FlyersRepo().ListActiveDeals(conn);

                // Usual (receipt-median) prices for mapped deals so the multi-buy label can carry a verdict.
                var mappedIds = deals.Where(d => d.ItemId is not null).Select(d => d.ItemId!.Value).Distinct().ToList();
                var usualMap = PricesRepo.GetUsualUnitPriceBatch(conn, mappedIds, receiptOnly: true,
                    minSamples: PriceDropAlertService.MinReceiptSamplesForUsual,
                    sinceDays: PriceDropAlertService.UsualLookbackDays);

                var hiddenCount = 0;
                var views = new List<(int StoreId, DealView View)>();
                foreach (var deal in deals)
                {
                    var text = $"{deal.Title} {deal.Description}";
                    if (eff.HardExcludes.Any(t => BasketOptimizerService.PhraseSafeHit(text, t)))
                    {
                        hiddenCount++;
                        continue;
                    }
                    var soft = eff.SoftExcludes.Any(t => BasketOptimizerService.PhraseSafeHit(text, t));

                    // Multi-buy truth: parse the promo phrase ("2/$5", "BOGO") into an effective unit price.
                    // Only a genuinely parsed deal gets the "= $X ea" label — no_deal/unit_from_total stay silent.
                    double? effUnit = null;
                    var adjusted = MultiBuy.Adjust($"{deal.PriceText} {deal.Title}", null,
                        (double?)deal.UnitPrice, (double?)deal.DealTotal, null);
                    if (adjusted.UnitPrice is > 0 && (adjusted.DealNote.StartsWith("bogo_effective")
                        || adjusted.DealNote.StartsWith("bundle") || adjusted.DealNote.StartsWith("at(")))
                        effUnit = adjusted.UnitPrice;

                    double? usual = null;
                    if (deal.ItemId is { } mappedId)
                        usual = usualMap.GetValueOrDefault(mappedId, (null, 0, "unknown")).Price;

                    views.Add((deal.StoreId, new DealView(deal, soft, effUnit, usual)));
                }

                var grouped = views.GroupBy(v => v.StoreId)
                    .Select(g => new StoreDeals(
                        storeNames.GetValueOrDefault(g.Key, $"Store #{g.Key}"),
                        g.Select(v => v.View).ToList()))
                    .OrderBy(g => g.StoreName, StringComparer.OrdinalIgnoreCase)
                    .ToList();
                return ((IReadOnlyList<StoreDeals>)grouped, hiddenCount);
            });
            _dealsByStore = groups;
            _hiddenHardExcluded = hidden;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SyncAsync()
    {
        _syncing = true;
        _syncMessage = null;
        _syncCts = new CancellationTokenSource();
        try
        {
            var result = await Sync.RequestSyncAsync(_syncCts.Token);
            if (result.SkippedReason is { } reason)
            {
                _syncSeverity = Severity.Info;
                _syncMessage = reason switch
                {
                    "busy" => "A sync is already running.",
                    "no_stores" => "Add stores before syncing flyers.",
                    _ => $"Sync skipped ({reason}).",
                };
            }
            else if (result.Errors.Count > 0)
            {
                _syncSeverity = Severity.Warning;
                _syncMessage = $"Synced {result.StoresSynced} store(s), {result.DealsInserted} deal(s). " +
                               string.Join(" ", result.Errors);
            }
            else
            {
                _syncSeverity = Severity.Success;
                _syncMessage = $"Synced {result.StoresSynced} store(s), {result.DealsInserted} new deal(s).";
            }
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            _syncSeverity = Severity.Info;
            _syncMessage = "Sync cancelled.";
        }
        catch (Exception ex)
        {
            _syncSeverity = Severity.Error;
            _syncMessage = $"Sync failed: {ex.Message}";
        }
        finally
        {
            _syncing = false;
            _syncCts?.Dispose();
            _syncCts = null;
        }
    }

    private void CancelSync() => _syncCts?.Cancel();

    public void Dispose() => _syncCts?.Cancel();
}
