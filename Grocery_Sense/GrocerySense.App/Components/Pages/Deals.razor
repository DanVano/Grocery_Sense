@page "/deals"
@using GrocerySense.Core
@using GrocerySense.Data
@using GrocerySense.Data.Repositories
@using GrocerySense.Domain
@implements IDisposable
@inject SqliteConnectionFactory Db
@inject PreferencesService Prefs
@inject FlyerSyncScheduler Sync
@inject FlyerIngestService FlyerIngest
@inject MultiBuyDealService MultiBuy
@inject ShoppingListService Shopping
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<MudText Typo="Typo.h5" GutterBottom="true">Deals</MudText>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SyncAsync" Disabled="@_syncing">
        Sync flyers
    </MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
               OnClick="ImportAsync" Disabled="@(_syncing || _importing)">
        Import flyer (photo/PDF)
    </MudButton>
    @if (_syncing || _importing)
    {
        <MudButton Variant="Variant.Text" OnClick="CancelSync">Cancel</MudButton>
        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Working" />
    }
</MudStack>
<MudText Typo="Typo.caption" Class="mb-2">
    Flyer sync sends your postal code to Flipp's unofficial service; imported flyer files are uploaded to your configured Azure OCR resource.
</MudText>

@if (_syncMessage is not null)
{
    <MudAlert Class="mb-2" Severity="@_syncSeverity" Dense="true">@_syncMessage</MudAlert>
}
@if (_error is not null)
{
    <MudAlert Class="mb-2" Severity="Severity.Error">@_error</MudAlert>
}

@if (_dealsByStore is null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" aria-label="Loading" />
    </div>
}
else if (_dealsByStore.Count == 0)
{
    <MudText Typo="Typo.body2">
        No active deals. Sync flyers to pull deals for your stores, or import a flyer photo/PDF.
    </MudText>
}
else
{
    @if (_hiddenHardExcluded > 0)
    {
        <MudText Typo="Typo.caption" Class="mb-1">
            @_hiddenHardExcluded deal(s) hidden by household hard-excludes.
        </MudText>
    }
    @if (DealPageCount > 1)
    {
        <MudPagination Count="@DealPageCount" Selected="@_dealPage" SelectedChanged="SelectDealPage"
                       ShowFirstButton="true" ShowLastButton="true" Class="mb-2" />
    }
    @foreach (var group in PageGroups())
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <MudText Typo="Typo.subtitle1">@group.StoreName</MudText>
            <MudList T="int" Dense="true">
                @foreach (var deal in group.Deals)
                {
                    <MudListItem T="int">
                        <div class="d-flex align-center gap-1">
                            <MudText Typo="Typo.body2">
                                @DealLabel(deal.Row)
                                @if (deal.EffectiveUnit is double eff)
                                {
                                    <span> = $@eff.ToString("0.00") ea</span>
                                }
                                @if (deal.EffectiveUnit is double e && deal.UsualPrice is double usual)
                                {
                                    @if (usual > 0 && (usual - e) / usual * 100.0 >= VerdictBelowUsualPct)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                            ↓ @(((usual - e) / usual * 100.0).ToString("0"))% vs usual
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">≈ usual — skip</MudChip>
                                    }
                                }
                                @if (deal.SoftExcluded)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default">avoid</MudChip>
                                }
                            </MudText>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small"
                                           OnClick="@(() => AddDealAsync(deal.Row))" aria-label="Add to shopping list" />
                        </div>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }
    @if (DealPageCount > 1)
    {
        <MudPagination Count="@DealPageCount" Selected="@_dealPage" SelectedChanged="SelectDealPage"
                       ShowFirstButton="true" ShowLastButton="true" Class="mt-2" />
    }
}

@code {
    private sealed record DealView(FlyerDeal Row, bool SoftExcluded, double? EffectiveUnit, double? UsualPrice);
    private sealed record StoreDeals(string StoreName, IReadOnlyList<DealView> Deals);

    // Verdict chip threshold: an effective price less than this % below usual reads "≈ usual — skip".
    private const double VerdictBelowUsualPct = 5.0;

    private IReadOnlyList<StoreDeals>? _dealsByStore;
    private int _hiddenHardExcluded;
    private string? _error;
    private bool _syncing;
    private bool _importing;
    private string? _syncMessage;
    private Severity _syncSeverity = Severity.Info;
    private CancellationTokenSource? _syncCts;

    private static readonly FilePickerFileType FlyerFileTypes = new(
        new Dictionary<DevicePlatform, IEnumerable<string>>
        {
            [DevicePlatform.Android] = new[] { "image/*", "application/pdf" },
            [DevicePlatform.iOS] = new[] { "public.image", "com.adobe.pdf" },
            [DevicePlatform.WinUI] = new[] { ".jpg", ".jpeg", ".png", ".webp", ".pdf" },
        });

    protected override Task OnInitializedAsync() => ReloadAsync();

    private static string DealLabel(FlyerDeal d)
    {
        var title = d.Title is { Length: > 0 } t ? t : d.Description is { Length: > 0 } de ? de : "(untitled)";
        var price = d.PriceText is { Length: > 0 } pt ? pt
            : d.UnitPrice is decimal up ? $"${up:0.00}{(d.Unit is { Length: > 0 } u ? $"/{u}" : "")}"
            : null;
        return price is null ? title : $"{title} — {price}";
    }

    private async Task ReloadAsync()
    {
        try
        {
            _error = null;
            var (groups, hidden) = await Task.Run(() =>
            {
                var eff = Prefs.ComputeEffectivePreferences();
                using var conn = Db.Open();
                var storeNames = StoresRepo.ListStores(conn).ToDictionary(s => s.Id, s => s.Name);
                var deals = new FlyersRepo().ListActiveDeals(conn);

                // Usual (receipt-median) prices for mapped deals so the multi-buy label can carry a verdict.
                var mappedIds = deals.Where(d => d.ItemId is not null).Select(d => d.ItemId!.Value).Distinct().ToList();
                var usualMap = PricesRepo.GetUsualUnitPriceBatch(conn, mappedIds, receiptOnly: true,
                    minSamples: PriceDropAlertService.MinReceiptSamplesForUsual,
                    sinceDays: PriceDropAlertService.UsualLookbackDays);

                var hiddenCount = 0;
                var views = new List<(int StoreId, DealView View)>();
                foreach (var deal in deals)
                {
                    var text = $"{deal.Title} {deal.Description}";
                    if (eff.HardExcludes.Any(t => BasketOptimizerService.PhraseSafeHit(text, t)))
                    {
                        hiddenCount++;
                        continue;
                    }
                    var soft = eff.SoftExcludes.Any(t => BasketOptimizerService.PhraseSafeHit(text, t));

                    // Multi-buy truth: parse the promo phrase ("2/$5", "BOGO") into an effective unit price.
                    // Only a genuinely parsed deal gets the "= $X ea" label — no_deal/unit_from_total stay silent.
                    double? effUnit = null;
                    var adjusted = MultiBuy.Adjust($"{deal.PriceText} {deal.Title}", null,
                        (double?)deal.UnitPrice, (double?)deal.DealTotal, null);
                    if (adjusted.UnitPrice is > 0 && (adjusted.DealNote.StartsWith("bogo_effective")
                        || adjusted.DealNote.StartsWith("bundle") || adjusted.DealNote.StartsWith("at(")))
                        effUnit = adjusted.UnitPrice;

                    double? usual = null;
                    if (deal.ItemId is { } mappedId)
                        usual = usualMap.GetValueOrDefault(mappedId, (null, 0, "unknown")).Price;

                    views.Add((deal.StoreId, new DealView(deal, soft, effUnit, usual)));
                }

                var grouped = views.GroupBy(v => v.StoreId)
                    .Select(g => new StoreDeals(
                        storeNames.GetValueOrDefault(g.Key, $"Store #{g.Key}"),
                        g.Select(v => v.View).ToList()))
                    .OrderBy(g => g.StoreName, StringComparer.OrdinalIgnoreCase)
                    .ToList();
                return ((IReadOnlyList<StoreDeals>)grouped, hiddenCount);
            });
            _dealsByStore = groups;
            _hiddenHardExcluded = hidden;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SyncAsync()
    {
        _syncing = true;
        _syncMessage = null;
        _syncCts = new CancellationTokenSource();
        try
        {
            var result = await Sync.RequestSyncAsync(_syncCts.Token);
            if (result.SkippedReason is { } reason)
            {
                _syncSeverity = Severity.Info;
                _syncMessage = reason switch
                {
                    "busy" => "A sync is already running.",
                    "no_stores" => "Add stores before syncing flyers.",
                    _ => $"Sync skipped ({reason}).",
                };
            }
            else if (result.Errors.Count > 0)
            {
                _syncSeverity = Severity.Warning;
                _syncMessage = $"Synced {result.StoresSynced} store(s), {result.DealsInserted} deal(s). " +
                               string.Join(" ", result.Errors);
            }
            else
            {
                _syncSeverity = Severity.Success;
                _syncMessage = $"Synced {result.StoresSynced} store(s), {result.DealsInserted} new deal(s).";
            }
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            _syncSeverity = Severity.Info;
            _syncMessage = "Sync cancelled.";
        }
        catch (Exception ex)
        {
            _syncSeverity = Severity.Error;
            _syncMessage = $"Sync failed: {ex.Message}";
        }
        finally
        {
            _syncing = false;
            _syncCts?.Dispose();
            _syncCts = null;
        }
    }

    // Manual flyer fallback: pick photo/PDF pages, confirm store + validity in a dialog, ingest via the
    // Azure layout client. Picks are copied into app-data first (source URIs can expire on Android).
    // Errors fail loud into the alert — missing Azure creds must read as "not configured", never as "no deals".
    private async Task ImportAsync()
    {
        _importing = true;
        _syncMessage = null;
        _syncCts = new CancellationTokenSource();
        var copied = new List<string>();
        var imported = false;
        try
        {
            var picks = await FilePicker.Default.PickMultipleAsync(new PickOptions
            {
                PickerTitle = "Pick flyer photos or PDFs",
                FileTypes = FlyerFileTypes,
            });
            var picked = picks?.Where(p => p is not null).Select(p => p!).ToList() ?? new List<FileResult>();
            if (picked.Count == 0) return; // user backed out

            List<Store> stores;
            using (var conn = Db.Open())
                stores = StoresRepo.ListStores(conn).ToList();
            if (stores.Count == 0)
            {
                _syncSeverity = Severity.Info;
                _syncMessage = "Add a store before importing a flyer.";
                return;
            }

            var parameters = new DialogParameters<FlyerImportDialog>
            {
                { d => d.Stores, stores },
                { d => d.FileCount, picked.Count },
            };
            var dialog = await DialogService.ShowAsync<FlyerImportDialog>("Import flyer", parameters);
            if (await dialog.Result is not { Canceled: false, Data: FlyerImportDialog.Result choice }) return;

            var ct = _syncCts.Token;
            foreach (var pick in picked)
                copied.Add(await CopyPickToAppDataAsync(pick, ct));

            var result = await FlyerIngest.IngestAssetsAsync(choice.StoreId, choice.ValidFrom, choice.ValidTo,
                copied, sourceType: "manual_upload", ct: ct);
            imported = true; // copies are now referenced by flyer_assets; don't delete them in finally

            _syncSeverity = Severity.Success;
            _syncMessage = $"Imported {result.DealsCount} deal(s) from {result.AssetsCount} page(s).";
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            _syncSeverity = Severity.Info;
            _syncMessage = "Import cancelled.";
        }
        catch (Exception ex)
        {
            _syncSeverity = Severity.Error;
            _syncMessage = $"Import failed: {ex.Message}";
        }
        finally
        {
            if (!imported)
                foreach (var path in copied)
                    TryDeleteFlyerFile(path);
            _importing = false;
            _syncCts?.Dispose();
            _syncCts = null;
        }
    }

    // Picker streams are copied into app-data before ingest (mirrors Receipts.razor — source paths expire).
    // Bounded: a hostile/huge picker file is rejected before the layout OCR client loads it fully into memory.
    private const long MaxImportBytes = 20L * 1024 * 1024;
    private static readonly HashSet<string> FlyerExtensions = new(StringComparer.OrdinalIgnoreCase)
        { ".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif", ".bmp", ".tif", ".tiff", ".pdf" };

    private static string FlyersDir() => Path.Combine(FileSystem.AppDataDirectory, "flyers");

    private static async Task<string> CopyPickToAppDataAsync(FileResult pick, CancellationToken ct)
    {
        await using var source = await pick.OpenReadAsync();
        return await BoundedFileCopy.CopyAsync(
            source, pick.FileName, FlyersDir(), FlyerExtensions,
            defaultExtension: ".jpg", maxBytes: MaxImportBytes, ct: ct);
    }

    // Deletes a copied flyer asset (only inside FlyersDir) when an import fails before the DB references it.
    private static void TryDeleteFlyerFile(string path)
    {
        if (!PathSafety.IsUnderDirectory(FlyersDir(), path)) return;
        try { File.Delete(path); } catch { /* best-effort cleanup */ }
    }

    // Add a deal to the active shopping list. Mapped deals land under their store with price intel; unmapped
    // deals land as a disclosed text row (see ShoppingListService.AddDealToList). List is user-managed —
    // duplicates are allowed, no dedupe.
    private async Task AddDealAsync(FlyerDeal deal)
    {
        try
        {
            var name = await Task.Run(() =>
            {
                Shopping.AddDealToList(deal);
                return DealLabel(deal);
            });
            // Actionable snackbar: one tap to the list the deal just landed in — no drawer trip (Phase 1a).
            Snackbar.Add($"Added {name}", Severity.Success, config =>
            {
                config.Action = "View list";
                config.ActionColor = Color.Primary;
                config.OnClick = _ => { Nav.NavigateTo("/list"); return Task.CompletedTask; };
            });
        }
        catch (Exception ex) { Snackbar.Add($"Couldn't add: {ex.Message}", Severity.Error); }
    }

    private void CancelSync() => _syncCts?.Cancel();

    public void Dispose() => _syncCts?.Cancel();
}
