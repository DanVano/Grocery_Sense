@page "/list"
@using GrocerySense.App.Services
@using GrocerySense.Core
@using GrocerySense.Data
@using GrocerySense.Data.Repositories
@using GrocerySense.Domain
@inject SqliteConnectionFactory Db
@inject ShoppingListService Shopping
@inject ShoppingInsightsService Insights
@inject StapleRestockService Restock
@inject BasketOptimizerService Optimizer
@inject ShopModeState ShopState
@inject IDialogService DialogService

<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.h5">Shopping List</MudText>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small" OnClick="ShareListAsync"
                   Disabled="@_busy" aria-label="Share list as text" />
    <MudSwitch T="bool" Value="@_shopMode" ValueChanged="@ToggleShopModeAsync" Color="Color.Primary"
               Label="Shop Mode" LabelPlacement="Placement.Start" />
</div>

@if (!_shopMode)
{
    @* Autocomplete against the item catalog (F06): a picked suggestion adds MAPPED (price intel,
       optimizer); free text and comma-separated multi-add keep working exactly as before. *@
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudAutocomplete T="string" @bind-Value="_newItems" Label="Add items (pick known, or comma-separated)"
                         SearchFunc="SearchCatalogAsync" CoerceValue="true" Clearable="true" MaxItems="20"
                         Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync"
                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_newItems))">Add</MudButton>
    </MudStack>

    @* Plan trip: optimize → preview → confirm → drop into Shop Mode, all on the List page.
       No hop to /plan for the core trip-prep flow (Phase 1b). The /plan page stays for the
       power path (History plan, budget-defer view). *@
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Class="mt-3">
        <MudRadioGroup T="string" @bind-Value="_planMode">
            <MudRadio T="string" Value="@("best_savings")" Color="Color.Primary" Dense="true">Best savings</MudRadio>
            <MudRadio T="string" Value="@("fewest_stops")" Color="Color.Primary" Dense="true">Fewest stops</MudRadio>
        </MudRadioGroup>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Route"
                   OnClick="PlanTripAsync" Disabled="@_busy">Plan trip</MudButton>
        @if (_busy && _planPreview is null)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Planning" />
        }
    </MudStack>

    @if (_planPreview is { } preview)
    {
        <MudPaper Class="pa-3 mt-2" Outlined="true">
            @foreach (var w in preview.Warnings)
            {
                <MudAlert Class="mb-2" Severity="Severity.Warning" Dense="true">@w</MudAlert>
            }
            @if (preview.Stores.Count == 0)
            {
                <MudText Typo="Typo.body2">Nothing to optimize — add list items and stores first.</MudText>
                <MudButton Class="mt-2" Variant="Variant.Text" OnClick="CancelPlan">Dismiss</MudButton>
            }
            else
            {
                <MudStack Row="true" Spacing="2" Class="mb-2">
                    <MudChip T="string" Color="Color.Primary">Basket est. $@F2(preview.BasketTotalEstimated)</MudChip>
                    @if (preview.SaveVsUsualAvg is double su)
                    {
                        <MudChip T="string" Color="Color.Success">vs usual $@F2(su)</MudChip>
                    }
                    @if (preview.SaveVsLowest is double sl)
                    {
                        <MudChip T="string" Color="Color.Default">vs 6-mo low $@F2(sl)</MudChip>
                    }
                </MudStack>
                @foreach (var store in preview.Stores)
                {
                    <MudPaper Class="pa-2 mb-2" Outlined="true">
                        <MudText Typo="Typo.subtitle2">
                            @store.StoreName — $@F2(store.TotalEstimated)
                            @(store.UnknownCount > 0 ? $" ({store.UnknownCount} unpriced)" : "")
                        </MudText>
                        <MudText Typo="Typo.caption">@string.Join(", ", store.Items.Select(i => i.Name))</MudText>
                    </MudPaper>
                }
                <MudStack Row="true" Spacing="2" Class="mt-1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShoppingCartCheckout"
                               OnClick="ConfirmPlanAsync" Disabled="@_busy">Confirm — start shopping</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelPlan" Disabled="@_busy">Cancel</MudButton>
                </MudStack>
            }
        </MudPaper>
    }

    @if (_restock is { Count: > 0 })
    {
        <MudPaper Class="pa-3 mt-2" Outlined="true">
            <div class="d-flex align-center">
                <MudText Typo="Typo.subtitle2">Probably running low</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_busy"
                           OnClick="AddAllRestockAsync">Add all</MudButton>
            </div>
            @foreach (var s in _restock)
            {
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.body2">
                        @s.Name — every ~@s.IntervalDays d, last bought @s.DaysSinceLast d ago
                    </MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_busy"
                               OnClick="@(() => AddRestockAsync(s))">Add</MudButton>
                </div>
            }
        </MudPaper>
    }
}

@if (_error is not null)
{
    <MudAlert Class="mt-2" Severity="Severity.Error">@_error</MudAlert>
}

@if (_shopMode)
{
    @if (_groups is null)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Indeterminate="true" aria-label="Loading" />
        </div>
    }
    else if (_groups.Count == 0)
    {
        <MudText Class="mt-4" Typo="Typo.body2">List is empty — switch off Shop Mode to add items.</MudText>
    }
    else
    {
        @if (_swapCoverageNote is not null)
        {
            <MudText Class="mt-2" Typo="Typo.caption">@_swapCoverageNote</MudText>
        }
        @foreach (var group in _groups)
        {
            <MudPaper Class="pa-3 mt-3" Outlined="true">
                <MudText Typo="Typo.subtitle1">
                    @group.StoreName — est. $@F2(group.SubtotalEstimated)
                    @(group.UnpricedCount > 0 ? $" ({group.UnpricedCount} unpriced)" : "")
                </MudText>
                @if (group.StoreId is null)
                {
                    <MudText Typo="Typo.caption">No planned store — run Plan → Optimize → Apply to assign.</MudText>
                }
                <MudList T="int" Dense="true">
                    @foreach (var i in group.Items)
                    {
                        <MudListItem T="int">
                            <div class="d-flex align-center gap-2">
                                <MudCheckBox T="bool" Value="@i.Row.IsCheckedOff"
                                             ValueChanged="@(v => ToggleAsync(i.Row.Id, v))" Dense="true" />
                                <div>
                                    <MudText Style="@(i.Row.IsCheckedOff ? "text-decoration: line-through" : null)">
                                        @i.Row.DisplayName@QtyLabel(i.Row)
                                        @switch (i.Badge)
                                        {
                                            case "stock_up":
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                                    Stock up@(i.SuggestedQty is double q ? $" ×{q:0.##}" : "")
                                                </MudChip>
                                                break;
                                            case "buy":
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                                    Buy@(i.PctBelowUsual is double p ? $" — {p:0}% below usual" : "")
                                                </MudChip>
                                                break;
                                            case "wait":
                                                @if (i.Row.Priority == "wait_for_sale")
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Waiting for sale</MudChip>
                                                }
                                                else if (i.Row.Priority != "must_have")
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                             OnClick="@(() => DeferAsync(i.Row.Id))">
                                                        Wait — tap to defer
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Above usual</MudChip>
                                                }
                                                break;
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption">@PriceLine(i)</MudText>
                                    @if (!string.IsNullOrWhiteSpace(i.Row.Notes))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@i.Row.Notes</MudText>
                                    }
                                    @if (i.SuggestedQtyNote is not null)
                                    {
                                        <MudText Typo="Typo.caption">@i.SuggestedQtyNote</MudText>
                                    }
                                    @if (_swapByRow.TryGetValue(i.Row.Id, out var swap))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Success">
                                            Swap: @swap.SwapToName $@F2(swap.SwapPrice) (save @swap.SavePct.ToString("0")%)
                                        </MudText>
                                    }
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
    }
}
else if (_items is null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" aria-label="Loading" />
    </div>
}
else if (_items.Count == 0)
{
    <MudText Class="mt-4" Typo="Typo.body2">List is empty — add something above.</MudText>
}
else
{
    <MudPaper Class="mt-3" Outlined="true">
        <MudList T="int" Dense="true">
            @foreach (var row in _items)
            {
                <MudListItem T="int">
                    <div class="d-flex align-center gap-1">
                        <MudCheckBox T="bool" Value="@row.IsCheckedOff"
                                     ValueChanged="@(v => ToggleAsync(row.Id, v))" Dense="true" />
                        <div>
                            <MudText Style="@(row.IsCheckedOff ? "text-decoration: line-through" : null)">
                                @row.DisplayName@QtyLabel(row)
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(row.Notes))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@row.Notes</MudText>
                            }
                        </div>
                        <MudSpacer />
                        <MudSelect T="string" Value="@row.Priority"
                                   ValueChanged="@(v => SetPriorityAsync(row.Id, v))"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Text"
                                   Style="max-width:150px" aria-label="Priority">
                            <MudSelectItem T="string" Value="@("must_have")">Must have</MudSelectItem>
                            <MudSelectItem T="string" Value="@("normal")">Normal</MudSelectItem>
                            <MudSelectItem T="string" Value="@("wait_for_sale")">Wait for sale</MudSelectItem>
                        </MudSelect>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditRowAsync(row))" aria-label="Edit item" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       OnClick="@(() => DeleteAsync(row.Id))" aria-label="Delete item" />
                    </div>
                </MudListItem>
            }
        </MudList>
    </MudPaper>
    <MudButton Class="mt-2" Variant="Variant.Text" OnClick="ClearCheckedAsync"
               Disabled="@(_busy || !_items.Any(i => i.IsCheckedOff))">Clear checked</MudButton>
}

@code {
    private IReadOnlyList<ShoppingListRow>? _items;
    private IReadOnlyList<RestockSuggestion> _restock = Array.Empty<RestockSuggestion>();
    private IReadOnlyList<ShopModeGroup>? _groups;
    private Dictionary<int, SwapSuggestion> _swapByRow = [];
    private string? _swapCoverageNote;
    private bool _shopMode;
    private string _newItems = "";
    private bool _busy;
    private string? _error;
    private string _planMode = "best_savings";
    private BasketOptimizationResult? _planPreview;

    protected override Task OnInitializedAsync()
    {
        _shopMode = ShopState.Enabled; // survive a tab-away/return (Phase 2b)
        return ReloadAsync();
    }

    private static string F2(double v) => v.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private static string QtyLabel(ShoppingListRow row)
    {
        if (row.Quantity == 1.0 && string.IsNullOrEmpty(row.Unit)) return "";
        var unit = string.IsNullOrEmpty(row.Unit) ? "" : $" {row.Unit}";
        return $" — {row.Quantity:0.##}{unit}";
    }

    private static string PriceLine(ListItemInsight i)
    {
        if (i.CurrentPrice is not double c) return "no price";
        var line = $"${F2(c)} ({i.PriceSource})";
        if (i.UsualPrice is double u) line += $" · usual ${F2(u)}";
        if (i.SixMonthLow is double l) line += $" · 6-mo low ${F2(l)}";
        return line;
    }

    private async Task ToggleShopModeAsync(bool on)
    {
        _shopMode = on;
        ShopState.Enabled = on;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _error = null;
            _items = await Task.Run(() => Shopping.GetActiveItems(includeCheckedOff: true));
            _restock = _shopMode
                ? Array.Empty<RestockSuggestion>()
                : await Task.Run(() => Restock.GetSuggestions());
            if (_shopMode)
            {
                var (groups, swaps) = await Task.Run(() =>
                {
                    var g = Insights.BuildShopModeView();
                    return (g, Insights.BuildSwapSuggestions(g));
                });
                _groups = groups;
                _swapByRow = swaps.Suggestions.ToDictionary(s => s.RowId);
                _swapCoverageNote = swaps.CoverageNote;
            }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private Task AddAsync() => RunAsync(() =>
    {
        Shopping.AddItemsFromText(_newItems);
        _newItems = "";
    });

    // Catalog suggestions while typing (F06). Comma lists are free-text multi-add — suggesting mid-list
    // would fight the field, so they get none. Free text that matches nothing still adds as before.
    private async Task<IEnumerable<string>> SearchCatalogAsync(string value, CancellationToken ct)
    {
        var q = (value ?? "").Trim();
        if (q.Length < 2 || q.Contains(',')) return [];
        return await Task.Run(() =>
        {
            using var conn = Db.Open();
            return (IEnumerable<string>)ItemsAdminRepo.SearchItems(conn, q)
                .Select(i => i.CanonicalName).Take(20).ToList();
        }, ct);
    }

    private Task AddRestockAsync(RestockSuggestion s) => RunAsync(() => AddRestock(s));

    private Task AddAllRestockAsync()
    {
        var batch = _restock;
        return RunAsync(() => { foreach (var s in batch) AddRestock(s); });
    }

    // RunAsync reloads afterwards, which refreshes _restock — added items drop out of the draft.
    private void AddRestock(RestockSuggestion s) =>
        Shopping.AddSingleItem(s.Name, itemId: s.ItemId, addedBy: "Restock",
            notes: $"You buy this every ~{s.IntervalDays} day(s); last bought {s.DaysSinceLast} day(s) ago");

    private Task ToggleAsync(int rowId, bool checkedOff) =>
        RunAsync(() => Shopping.CheckOffItem(rowId, checkedOff));

    private Task DeleteAsync(int rowId) => RunAsync(() => Shopping.SoftDeleteItem(rowId));

    // Edit quantity/unit/notes in place (F05) — no more delete + re-add for a typo'd quantity.
    private async Task EditRowAsync(ShoppingListRow row)
    {
        var parameters = new DialogParameters<ListItemEditDialog> { { x => x.Row, row } };
        var dialog = await DialogService.ShowAsync<ListItemEditDialog>($"Edit \"{row.DisplayName}\"", parameters);
        if (await dialog.Result is not { Canceled: false, Data: ListItemEditDialog.Result edited }) return;
        await RunAsync(() => Shopping.UpdateItemDetails(row.Id, edited.Quantity, edited.Unit, edited.Notes));
    }

    private Task SetPriorityAsync(int rowId, string priority) =>
        RunAsync(() => Shopping.SetItemPriority(rowId, priority));

    // Shop Mode "Wait" chip: one-tap defer to wait_for_sale (optimizer then skips it unless it's on sale).
    private Task DeferAsync(int rowId) => RunAsync(() => Shopping.SetItemPriority(rowId, "wait_for_sale"));

    private Task ClearCheckedAsync() => RunAsync(Shopping.ClearAllCheckedOff);

    // Share the list as plain text via the OS share sheet (F07).
    private async Task ShareListAsync()
    {
        try
        {
            _error = null;
            var text = await Task.Run(Shopping.FormatListAsText);
            await Share.Default.RequestAsync(new ShareTextRequest { Text = text, Title = "Shopping list" });
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // Plan trip (Phase 1b): run the optimizer and hold the result as a preview — nothing is written until
    // the user confirms. Reuses the same service the /plan page drives.
    private async Task PlanTripAsync()
    {
        _busy = true;
        try
        {
            _error = null;
            _planPreview = await Task.Run(() => Optimizer.Optimize(_planMode));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // Confirm: write the previewed plan back to the active list, then drop straight into Shop Mode —
    // that store-grouped shopping view is the whole point of the flow. A failed apply keeps the preview
    // dismissed and surfaces the reason; we never silently pretend it worked.
    private async Task ConfirmPlanAsync()
    {
        if (_planPreview is not { } preview) return;
        _busy = true;
        try
        {
            _error = null;
            var result = await Task.Run(() => Shopping.ApplyOptimizerPlanToActiveList(preview, _planMode));
            if (!result.Ok) { _error = result.Error; return; }
            _planPreview = null;
            _shopMode = true;
            ShopState.Enabled = true;
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void CancelPlan() => _planPreview = null;

    // All writes funnel through here: off the UI thread, then reload; errors surface in the alert.
    private async Task RunAsync(Action work)
    {
        _busy = true;
        try
        {
            _error = null;
            await Task.Run(work);
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
