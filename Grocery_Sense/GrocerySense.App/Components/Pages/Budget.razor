@page "/budget"
@inject BudgetService BudgetSvc

<MudText Typo="Typo.h5" GutterBottom="true">Budget</MudText>

@if (_error is not null)
{
    <MudAlert Class="mb-2" Severity="Severity.Error">@_error</MudAlert>
}

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
    <MudNumericField T="double?" @bind-Value="_budgetInput" Label="Monthly budget ($)" Min="0"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_busy">Save</MudButton>
</MudStack>

@if (_status is null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" aria-label="Loading" />
    </div>
}
else
{
    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@_status.Month</MudText>
        <MudText Typo="Typo.body2">
            Spent $@_status.Spent.ToString("0.00") across @_status.ReceiptCount receipt(s)@(
                _status.Budget is decimal b ? $" of ${b:0.00}" : " — no budget set").
        </MudText>
        @if (_status.Budget is not null)
        {
            <MudProgressLinear Class="mt-2" Color="@StatusColor(_status.Status)" Rounded="true" Size="Size.Large"
                               Value="@Math.Min(_status.PctUsed ?? 0, 100.0)" aria-label="Budget used" />
            <MudText Typo="Typo.caption">
                @($"{_status.PctUsed ?? 0:0.#}% used")
                @(_status.Remaining is decimal r ? $" — ${r:0.00} remaining" : "")
            </MudText>
        }
        @if (_inflation is { EnoughHistory: true, SpendYoyPct: double yoy })
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2">
                Your spend @yoy.ToString("+0.0;-0.0")% y/y@(_inflation.FoodInflationPct is double fp
                    ? $" · CAD food inflation {fp.ToString("+0.0;-0.0", System.Globalization.CultureInfo.InvariantCulture)}%"
                    : "")
            </MudText>
        }
        else if (_inflation is not null)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2 mud-text-secondary">
                Not enough history yet for a year-over-year comparison.
            </MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">Month-end forecast</MudText>
        <MudText Typo="Typo.body2">
            At the current pace you'll spend about
            <b>$@_status.ProjectedSpend.ToString("0.00")</b> by month-end@(
                _status.Budget is decimal pb ? $" against a ${pb:0.00} budget" : "").
        </MudText>
        @if (_status.ProjectedStatus is "warning" or "over")
        {
            <MudAlert Class="mt-2" Dense="true"
                      Severity="@(_status.ProjectedStatus == "over" ? Severity.Error : Severity.Warning)">
                @(_status.ProjectedStatus == "over"
                    ? "Projected to go over budget this month."
                    : "Projected to get close to the budget this month.")
            </MudAlert>
        }
    </MudPaper>

    @if (_byStore is { Count: > 0 })
    {
        <MudPaper Class="pa-3 mb-3" Outlined="true">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">This month by store</MudText>
            <MudSimpleTable Dense="true">
                <thead>
                    <tr><th style="text-align:left">Store</th><th style="text-align:right">Spent</th><th style="text-align:right">Receipts</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in _byStore)
                    {
                        <tr>
                            <td>@(s.StoreName is { Length: > 0 } n ? n : $"Store #{s.StoreId}")</td>
                            <td style="text-align:right">$@s.Total.ToString("0.00")</td>
                            <td style="text-align:right">@s.ReceiptCount</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }

    <MudText Typo="Typo.subtitle1" GutterBottom="true">Spend trend</MudText>
    @if (_trend is { Count: > 0 })
    {
        <MudSimpleTable Dense="true">
            <thead>
                <tr><th style="text-align:left">Month</th><th style="text-align:right">Spent</th><th style="text-align:right">Receipts</th></tr>
            </thead>
            <tbody>
                @foreach (var point in _trend)
                {
                    <tr>
                        <td>@point.Month</td>
                        <td style="text-align:right">$@point.Total.ToString("0.00")</td>
                        <td style="text-align:right">@point.ReceiptCount</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
    else
    {
        <MudText Typo="Typo.body2">No spend history yet — import receipts to build the trend.</MudText>
    }
}

@code {
    private BudgetStatus? _status;
    private IReadOnlyList<MonthSpend>? _trend;
    private IReadOnlyList<StoreMonthSpend>? _byStore;
    private InflationContext? _inflation;
    private double? _budgetInput;
    private bool _busy;
    private string? _error;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private static Color StatusColor(string status) => status switch
    {
        "over" => Color.Error,
        "warning" => Color.Warning,
        _ => Color.Success,
    };

    private async Task ReloadAsync()
    {
        try
        {
            _error = null;
            (_status, _trend, _byStore, _inflation) = await Task.Run(() =>
                (BudgetSvc.GetBudgetStatus(), BudgetSvc.GetTrend(), BudgetSvc.GetMonthStoreBreakdown(),
                 BudgetSvc.GetInflationContext()));
            _budgetInput = _status.Budget is decimal b ? (double)b : null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            _error = null;
            var amount = _budgetInput;
            await Task.Run(() => BudgetSvc.SaveMonthlyBudget(amount));
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
