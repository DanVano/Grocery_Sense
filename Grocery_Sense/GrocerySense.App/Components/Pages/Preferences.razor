@page "/preferences"
@using System.Text.Json
@using GrocerySense.Core
@using static GrocerySense.App.ServiceCollectionExtensions
@inject ConfigStore Config
@inject ISnackbar Snackbar
@inject DbMaintenanceService Maintenance

<MudText Typo="Typo.h5" GutterBottom="true">Preferences</MudText>

@if (_error is not null)
{
    <MudAlert Class="mb-2" Severity="Severity.Error">@_error</MudAlert>
}
@if (_saved)
{
    <MudAlert Class="mb-2" Severity="Severity.Success" Dense="true">Preferences saved.</MudAlert>
}

@if (!_loaded)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" aria-label="Loading" />
    </div>
}
else
{
    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">Location</MudText>
        <MudStack Row="true" Spacing="2">
            <MudTextField @bind-Value="_postal" Label="Postal code" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_city" Label="City" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudText Typo="Typo.subtitle1">Dietary excludes</MudText>
        <MudText Typo="Typo.caption">Comma-separated. Allergies and hard-excludes are removed from deals and pulled out of plans; avoid items are only flagged.</MudText>
        <MudTextField @bind-Value="_allergies" Label="Allergies" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        <MudTextField @bind-Value="_hardExcludes" Label="Hard excludes" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        <MudTextField @bind-Value="_softExcludes" Label="Avoid (soft)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudText Typo="Typo.subtitle1">Meal preferences</MudText>
        <MudText Typo="Typo.caption">Comma-separated. Preferred proteins/cuisines rank matching recipes higher; avoided proteins hide recipes containing them.</MudText>
        <MudTextField @bind-Value="_preferProteins" Label="Preferred proteins" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        <MudTextField @bind-Value="_avoidProteins" Label="Avoid proteins" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        <MudTextField @bind-Value="_cuisines" Label="Favorite cuisines / tags" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudText Typo="Typo.subtitle1">Household members</MudText>
        <MudText Typo="Typo.caption">Names only — everyone shares one preference set. Members let family meal-picks be attributed and reviewed.</MudText>
        @foreach (var m in _members)
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
                @if (_renamingMemberId == m.Id)
                {
                    <MudTextField @bind-Value="_memberRenameText" Label="Name" Immediate="true" Margin="Margin.Dense" />
                    <MudButton Size="Size.Small" Color="Color.Primary" Disabled="@_busy" OnClick="@(() => SaveMemberRenameAsync(m.Id))">Save</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _renamingMemberId = null)">Cancel</MudButton>
                }
                else
                {
                    <MudText>@m.Name</MudText>
                    @if (m.Role == "master")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">parent</MudChip>
                    }
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_busy" OnClick="@(() => StartMemberRename(m))">Rename</MudButton>
                    @if (m.Role != "master")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="@_busy"
                                   OnClick="@(() => DeleteMemberAsync(m.Id))">Remove</MudButton>
                    }
                }
            </MudStack>
        }
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
            <MudTextField @bind-Value="_newMember" Label="Add member" Immediate="true" Margin="Margin.Dense" />
            <MudButton Size="Size.Small" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_newMember))"
                       OnClick="AddMemberAsync">Add</MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudText Typo="Typo.subtitle1">Store optimizer</MudText>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            <MudNumericField @bind-Value="_maxStores" Label="Max stores" Min="1" Max="10"
                             Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudNumericField @bind-Value="_minItemSavingPct" Label="Min item saving (%)" Min="1" Max="100"
                             Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudNumericField @bind-Value="_minStoreSaving" Label="Min store saving ($)" Min="0"
                             Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudText Typo="Typo.subtitle1">Food inflation rates</MudText>
        <MudText Typo="Typo.caption">
            Annual CAD food-price inflation per year (seeded from StatCan). Edit the current year's provisional
            figure and add each January's final number. Used to age old prices to today's dollars for the deal
            and optimizer baselines. Allowed range −20% to 50% (out-of-range values are rejected, not clamped).
        </MudText>
        @foreach (var row in _rates)
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
                <MudText Style="min-width:3.5rem">@row.Year</MudText>
                <MudNumericField T="double" @bind-Value="row.Pct" Label="Annual %" Min="-20" Max="50" Step="0.1"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:9rem" />
            </MudStack>
        }
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-3">
            <MudNumericField T="int" @bind-Value="_newRateYear" Label="Year" Min="2000" Max="2100"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:7rem" />
            <MudNumericField T="double" @bind-Value="_newRatePct" Label="Annual %" Min="-20" Max="50" Step="0.1"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:9rem" />
            <MudButton Size="Size.Small" Color="Color.Primary" OnClick="AddRateRow"
                       Disabled="@(_newRateYear <= 0)">Add year</MudButton>
        </MudStack>
    </MudPaper>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_busy">Save preferences</MudButton>

    <MudPaper Class="pa-3 mt-4" Outlined="true">
        <MudText Typo="Typo.subtitle1">Data &amp; backup</MudText>
        <MudText Typo="Typo.caption">Backup copies the database only (not receipt images). Files are handed to the share sheet — save them to Drive or email.</MudText>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Backup"
                       OnClick="BackupAsync" Disabled="@_busy">Back up database</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableView"
                       OnClick="@(() => ExportAsync("csv"))" Disabled="@_busy">Export CSV</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DataObject"
                       OnClick="@(() => ExportAsync("json"))" Disabled="@_busy">Export JSON</MudButton>
        </MudStack>
        @if (_lastBackup is { Length: > 0 })
        {
            <MudText Typo="Typo.caption" Class="mt-2">Last backup: @_lastBackup</MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-3 mt-4" Outlined="true">
        <MudText Typo="Typo.subtitle1">Cloud OCR (Azure)</MudText>
        <MudTextField @bind-Value="_azureEndpoint" Label="Endpoint" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Class="mt-2" />
        <MudTextField @bind-Value="_azureKey" Label="API key" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Class="mt-2" InputType="InputType.Password" />
        <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Secondary"
                   OnClick="SaveCredentialsAsync" Disabled="@_busy">Save credentials</MudButton>
    </MudPaper>
}

@code {
    private bool _loaded;
    private bool _busy;
    private bool _saved;
    private string? _error;

    private string _postal = "";
    private string _city = "";
    private string _allergies = "";
    private string _hardExcludes = "";
    private string _softExcludes = "";
    private string _preferProteins = "";
    private string _avoidProteins = "";
    private string _cuisines = "";
    private int _maxStores = 3;
    private int _minItemSavingPct = 10;
    private double _minStoreSaving = 5.0;
    private List<RateRow> _rates = new();
    private int _newRateYear;
    private double _newRatePct;

    // Reference type so @bind-Value mutates the row in place across the list.
    private sealed class RateRow { public int Year { get; set; } public double Pct { get; set; } }
    private string _azureEndpoint = "";
    private string _azureKey = "";
    private IReadOnlyList<HouseholdMember> _members = Array.Empty<HouseholdMember>();
    private int? _renamingMemberId;
    private string _memberRenameText = "";
    private string _newMember = "";
    private string _lastBackup = "";

    private const string LastBackupKey = "last_backup_utc";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cfg = Config.Load();
            _members = cfg.Household.Members;
            _lastBackup = FormatStamp(Microsoft.Maui.Storage.Preferences.Default.Get(LastBackupKey, ""));
            _postal = cfg.PostalCode;
            _city = cfg.City;
            _maxStores = cfg.MaxStores;
            _minItemSavingPct = (int)Math.Round(cfg.MinItemSavingPct * 100);
            _minStoreSaving = cfg.MinStoreSaving;
            _rates = (cfg.FoodInflationByYear ?? InflationRates.Seed)
                .Select(kv => new RateRow { Year = int.TryParse(kv.Key, out var y) ? y : 0, Pct = kv.Value })
                .Where(r => r.Year > 0)
                .OrderBy(r => r.Year)
                .ToList();

            var profile = Config.GetMasterMember().Profile;
            _allergies = AsCommaList(profile.GetValueOrDefault("allergies"));
            _hardExcludes = AsCommaList(profile.GetValueOrDefault("hard_excludes"));
            _softExcludes = AsCommaList(profile.GetValueOrDefault("soft_excludes"));
            _preferProteins = AsWeightKeys(profile.GetValueOrDefault("preferred_protein_weights"));
            _avoidProteins = AsCommaList(profile.GetValueOrDefault("excluded_proteins"));
            _cuisines = AsCommaList(profile.GetValueOrDefault("favorite_cuisines"));

            try
            {
                _azureEndpoint = await SecureStorage.Default.GetAsync(AzureDocIntEndpointKey) ?? "";
                _azureKey = await SecureStorage.Default.GetAsync(AzureDocIntApiKeyKey) ?? "";
            }
            catch (Exception ex)
            {
                // SecureStorage can be unavailable (e.g. no keystore) — surface it, don't fake creds.
                _error = $"Secure store unavailable: {ex.Message}";
            }

            _loaded = true;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _saved = false;
        try
        {
            _error = null;
            // Reject out-of-range rates loudly (never clamp — a 900% typo would corrupt every adjusted baseline).
            if (_rates.FirstOrDefault(r => !InflationRates.IsRateInBounds(r.Pct)) is { } bad)
            {
                _error = $"Food inflation rate for {bad.Year} ({bad.Pct:0.#}%) is out of range " +
                         $"({InflationRates.RateMinPct:0}% to {InflationRates.RateMaxPct:0}%).";
                return; // finally still resets _busy
            }
            await Task.Run(() =>
            {
                var cfg = Config.Load();
                var master = Config.GetMasterMember();
                // Preserve every other profile key (diet, spice_level, oils, …) — only the three edited lists change.
                var profile = new Dictionary<string, object?>(master.Profile)
                {
                    ["allergies"] = ParseList(_allergies),
                    ["hard_excludes"] = ParseList(_hardExcludes),
                    ["soft_excludes"] = ParseList(_softExcludes),
                    // Preferred proteins become weights > 1.0 (GetMealProfile reads any weight above 1 as preferred).
                    ["preferred_protein_weights"] = ParseList(_preferProteins).ToDictionary(p => p, _ => 2.0),
                    ["excluded_proteins"] = ParseList(_avoidProteins),
                    ["favorite_cuisines"] = ParseList(_cuisines),
                };
                var members = cfg.Household.Members
                    .Select(m => m.Id == master.Id ? m with { Profile = profile } : m).ToList();

                Config.Save(cfg with
                {
                    PostalCode = _postal?.Trim() ?? "",
                    City = _city?.Trim() ?? "",
                    MaxStores = _maxStores,
                    MinItemSavingPct = _minItemSavingPct / 100.0,
                    MinStoreSaving = _minStoreSaving,
                    FoodInflationByYear = _rates.ToDictionary(r => r.Year.ToString(), r => r.Pct),
                    Household = cfg.Household with { Members = members },
                });
            });
            _saved = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // Credentials live in SecureStorage, a separate store from user_config.json, so they get their own Save.
    // A cleared field removes the entry rather than storing an empty string.
    private async Task SaveCredentialsAsync()
    {
        _busy = true;
        try
        {
            _error = null;
            if (ValidateEndpoint(_azureEndpoint) is { } endpointError)
            {
                _error = endpointError;
                return;
            }
            await SetOrRemoveAsync(AzureDocIntEndpointKey, _azureEndpoint);
            await SetOrRemoveAsync(AzureDocIntApiKeyKey, _azureKey);
            Snackbar.Add("Cloud OCR credentials saved.", Severity.Success);
        }
        catch (Exception ex) { _error = $"Could not save credentials: {ex.Message}"; }
        finally { _busy = false; }
    }

    // The key is sent as a header to whatever host this endpoint names, so pin it to Azure Cognitive Services
    // before saving — a pasted phishing URL would otherwise exfiltrate the key. Empty = clearing the entry, allowed.
    private static string? ValidateEndpoint(string endpoint)
    {
        endpoint = endpoint.Trim();
        if (endpoint.Length == 0) return null;
        if (!Uri.TryCreate(endpoint, UriKind.Absolute, out var uri) || uri.Scheme != Uri.UriSchemeHttps)
            return "Endpoint must be an https:// URL.";
        var host = uri.Host;
        var ok = host.EndsWith(".cognitiveservices.azure.com", StringComparison.OrdinalIgnoreCase)
                 || host.EndsWith(".api.cognitive.microsoft.com", StringComparison.OrdinalIgnoreCase);
        return ok ? null : "Endpoint host must be an Azure Cognitive Services domain (e.g. myresource.cognitiveservices.azure.com).";
    }

    private static Task SetOrRemoveAsync(string key, string value)
    {
        value = value.Trim();
        if (value.Length > 0) return SecureStorage.Default.SetAsync(key, value);

        SecureStorage.Default.Remove(key);
        return Task.CompletedTask;
    }

    // Backup/export write to the app cache, then hand the file(s) to the OS share sheet — no new permissions,
    // no folder picker (grill Q15). Backup is the DB only; receipt images are excluded.
    private async Task BackupAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var dest = Path.Combine(FileSystem.CacheDirectory, $"grocery_sense_{DateTime.Now:yyyyMMdd_HHmmss}.db");
            await Task.Run(() => Maintenance.BackupDatabase(dest));
            await Share.Default.RequestAsync(new ShareFileRequest { Title = "Grocery Sense backup", File = new ShareFile(dest) });
            var now = DateTimeOffset.Now;
            Microsoft.Maui.Storage.Preferences.Default.Set(LastBackupKey, now.ToString("o"));
            _lastBackup = now.ToString("g");
            Snackbar.Add("Backup ready to share.", Severity.Success);
        }
        catch (Exception ex) { _error = $"Backup failed: {ex.Message}"; }
        finally { _busy = false; }
    }

    private async Task ExportAsync(string format)
    {
        _busy = true;
        _error = null;
        try
        {
            var dir = Path.Combine(FileSystem.CacheDirectory, $"export_{format}_{DateTime.Now:yyyyMMdd_HHmmss}");
            var files = await Task.Run(() =>
                format == "json" ? Maintenance.ExportToJson(dir) : Maintenance.ExportToCsv(dir));
            if (files.Count == 0)
            {
                Snackbar.Add("Nothing to export yet.", Severity.Info);
                return;
            }
            await Share.Default.RequestAsync(new ShareMultipleFilesRequest
            {
                Title = $"Grocery Sense {format.ToUpperInvariant()} export",
                Files = files.Select(f => new ShareFile(f)).ToList(),
            });
            Snackbar.Add($"{files.Count} file(s) ready to share.", Severity.Success);
        }
        catch (Exception ex) { _error = $"Export failed: {ex.Message}"; }
        finally { _busy = false; }
    }

    // Add or update a year's rate. Persisted only when the user hits Save preferences (with validation).
    private void AddRateRow()
    {
        if (_newRateYear <= 0) return;
        if (_rates.FirstOrDefault(r => r.Year == _newRateYear) is { } existing) existing.Pct = _newRatePct;
        else _rates.Add(new RateRow { Year = _newRateYear, Pct = _newRatePct });
        _rates = _rates.OrderBy(r => r.Year).ToList();
        _newRateYear = 0;
        _newRatePct = 0;
    }

    private static string FormatStamp(string iso) =>
        DateTimeOffset.TryParse(iso, out var dt) ? dt.ToLocalTime().ToString("g") : "";

    private void StartMemberRename(HouseholdMember m)
    {
        _error = null;
        _renamingMemberId = m.Id;
        _memberRenameText = m.Name;
    }

    private Task SaveMemberRenameAsync(int memberId) =>
        MemberOp(() => Config.RenameMember(memberId, _memberRenameText), afterSuccess: () => _renamingMemberId = null);

    private Task AddMemberAsync() =>
        MemberOp(() => Config.AddMember(_newMember), afterSuccess: () => _newMember = "");

    private Task DeleteMemberAsync(int memberId) => MemberOp(() => Config.DeleteMember(memberId));

    private async Task MemberOp(Action op, Action? afterSuccess = null)
    {
        _busy = true;
        _error = null;
        try
        {
            await Task.Run(op);
            afterSuccess?.Invoke();
            _members = Config.Load().Household.Members;
        }
        catch (Exception ex) { _error = ex.Message; }   // e.g. can't delete the master/last member
        finally { _busy = false; }
    }

    // preferred_protein_weights is a {protein: weight} map; surface proteins weighted above 1.0 as a comma list.
    private static string AsWeightKeys(object? value)
    {
        var keys = new List<string>();
        if (value is JsonElement { ValueKind: JsonValueKind.Object } je)
        {
            foreach (var p in je.EnumerateObject())
                if (p.Value.ValueKind == JsonValueKind.Number && p.Value.GetDouble() > 1.0) keys.Add(p.Name);
        }
        // In-session (no JSON round-trip) the runtime type is Dictionary<string, double>, which does NOT match
        // the generic IDictionary<string, object?>. Match the non-generic IDictionary — as NormWeights does —
        // so preferred proteins survive a navigate-away-and-back without being wiped on the next Save.
        else if (value is System.Collections.IDictionary map)
        {
            foreach (System.Collections.DictionaryEntry kv in map)
                if (kv.Key is { } k && Convert.ToDouble(kv.Value) > 1.0) keys.Add(k.ToString() ?? "");
        }
        return string.Join(", ", keys.Where(k => k.Length > 0));
    }

    private static List<string> ParseList(string csv) =>
        csv.Split(',').Select(s => s.Trim().ToLowerInvariant()).Where(s => s.Length > 0).Distinct().ToList();

    // Profile values arrive as JsonElement (from disk) or List<string> (defaults); render either as a comma list.
    private static string AsCommaList(object? value) => value switch
    {
        null => "",
        string s => s,
        JsonElement je when je.ValueKind == JsonValueKind.Array =>
            string.Join(", ", je.EnumerateArray().Select(e => e.ValueKind == JsonValueKind.String ? e.GetString() : e.ToString())),
        JsonElement je when je.ValueKind == JsonValueKind.String => je.GetString() ?? "",
        System.Collections.IEnumerable seq => string.Join(", ", seq.Cast<object?>().Select(o => o?.ToString())),
        _ => value.ToString() ?? "",
    };
}
