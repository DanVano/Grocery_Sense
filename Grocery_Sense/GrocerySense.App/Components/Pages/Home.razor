@page "/"
@inject ShoppingListService Shopping
@inject PriceDropAlertService Alerts
@inject FamilyRequestsService Family
@inject StapleRestockService Restock
@inject BudgetService Budget
@inject SqliteConnectionFactory Db
@inject ShopModeState ShopState
@inject NavigationManager Nav

<MudText Typo="Typo.h5" GutterBottom="true">Grocery Sense</MudText>

@if (_error is not null)
{
    <MudAlert Class="mb-2" Severity="Severity.Error">@_error</MudAlert>
}

@if (_loading)
{
    <Loading />
}
else
{
    @* Resume first: an unfinished shop outranks anything else on this screen. Checked-off rows are
       persisted, so a half-done trip survives the app being closed. *@
    @if (_pickedUp > 0)
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <MudText Typo="Typo.subtitle1">Shopping in progress</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@_pickedUp of @_listTotal picked up.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ShoppingCartCheckout"
                       OnClick="ResumeShopping">Resume shopping</MudButton>
        </MudPaper>
    }

    @* Realized savings (V3 Phase 5): only closed trips with computable savings speak here — no trips or
       all-null savings = no card, never a fabricated $0. Negative reads as spent-more, honestly. *@
    @if (_monthSavings is { Total: { } saved })
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <MudText Typo="Typo.subtitle1">
                @(saved >= 0 ? $"Saved ${saved:0.00} this month" : $"Spent ${Math.Abs(saved):0.00} more than usual this month")
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                vs your usual prices, across @_monthSavings.TripsWithSavings closed trip(s).
            </MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Savings" Href="/budget">See budget</MudButton>
        </MudPaper>
    }

    @* Smart Week entry point (V3 F1, grill Q10): one compact card, no new nav destination. *@
    @if (_pickedUp == 0)
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <MudText Typo="Typo.subtitle1">Plan an affordable week</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Protein-focused meals from this week's prices, pantry-checked, straight onto your list.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Restaurant" Href="/meals">Smart Week</MudButton>
        </MudPaper>
    }

    <MudPaper Class="pa-3 mb-2" Outlined="true">
        <MudText Typo="Typo.subtitle1">Deals</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @(_dealCount > 0
                ? $"{_dealCount} active deal(s) across your stores."
                : "No active deals — sync flyers to pull them in.")
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.LocalOffer" Href="/deals">Browse deals</MudButton>
    </MudPaper>

    @if (_alertCount > 0)
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <MudText Typo="Typo.subtitle1">@_alertCount price alert(s)</MudText>
            @if (_topAlert is { Length: > 0 } top)
            {
                <MudText Typo="Typo.body2" Class="mb-2">Latest: @top</MudText>
            }
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.TrendingDown" Href="/savings">See savings</MudButton>
        </MudPaper>
    }

    @* Essentials surfacing (V3 grill Q16): pull-based card, no OS notifications. *@
    @if (_essentialsDue > 0)
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <MudText Typo="Typo.subtitle1">@_essentialsDue essential(s) due soon</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Staples you usually rebuy about now.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Inventory" Href="/savings">See essentials</MudButton>
        </MudPaper>
    }

    @if (_familyCount > 0)
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <MudText Typo="Typo.subtitle1">@_familyCount family request(s)</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Waiting for your review.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Groups" Href="/family">Review</MudButton>
        </MudPaper>
    }

    @if (_pickedUp == 0 && _listTotal > 0)
    {
        <MudPaper Class="pa-3 mb-2" Outlined="true">
            <MudText Typo="Typo.subtitle1">Shopping list</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@_listTotal item(s) ready to plan.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Checklist" Href="/list">Open list</MudButton>
        </MudPaper>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private int _pickedUp;
    private int _listTotal;
    private int _dealCount;
    private int _alertCount;
    private string? _topAlert;
    private int _familyCount;
    private int _essentialsDue;
    private MonthlySavings? _monthSavings;

    // Every figure here is a cheap read of already-persisted state — Home must not recompute the
    // deal/alert engines on the landing screen. Alerts are read, never refreshed, for the same reason.
    // Restock cadence is the one computed figure: three batch queries over a small DB, deliberately
    // allowed so the essentials card can exist without a notification pipeline (grill Q16).
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.Run(() =>
            {
                var items = Shopping.GetActiveItems(includeCheckedOff: true);
                _listTotal = items.Count;
                _pickedUp = items.Count(i => i.IsCheckedOff);

                var alerts = Alerts.GetAlerts(limit: 50);
                _alertCount = alerts.Count;
                _topAlert = alerts.Count > 0 ? alerts[0].ItemName : null;

                _familyCount = Family.UnreviewedCount();
                _essentialsDue = Restock.GetSuggestions().Count;
                _monthSavings = Budget.GetMonthRealizedSavings();

                using var conn = Db.Open();
                _dealCount = FlyersRepo.CountActiveDeals(conn); // COUNT, not 5 000 materialized rows
            });
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    // Drop straight back into the store-grouped shopping view the user left.
    private void ResumeShopping()
    {
        ShopState.Enabled = true;
        Nav.NavigateTo("/list");
    }
}
