@page "/meals"
@inject WeeklyPlannerService Planner

<MudText Typo="Typo.h5" GutterBottom="true">Meal planning</MudText>
<MudText Typo="Typo.body2" Class="mb-2">
    Suggests value-focused recipes from your preferences, current flyer deals, and receipt-price history,
    then aggregates their ingredients into a shopping list.
</MudText>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
    <MudNumericField T="int" @bind-Value="_numRecipes" Label="Recipes" Min="1" Max="12" Style="max-width:110px" />
    <MudSelect T="string" @bind-Value="_sortBy" Label="Sort" Dense="true" Style="max-width:180px">
        <MudSelectItem T="string" Value="@("score")">Best value</MudSelectItem>
        <MudSelectItem T="string" Value="@("new_spend")">Lowest new spend</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Restaurant"
               OnClick="SuggestAsync" Disabled="@_busy">Suggest meals</MudButton>
    @if (_plan is not null && !_persisted)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddShoppingCart"
                   OnClick="AddToListAsync" Disabled="@_busy">Add ingredients to list</MudButton>
    }
    @if (_busy)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Working" />
    }
</MudStack>

@if (_message is not null)
{
    <MudAlert Class="mb-2" Severity="@_messageSeverity" Dense="true">@_message</MudAlert>
}

@if (_plan is not null)
{
    @if (_plan.Suggestions.Count == 0)
    {
        <MudText Typo="Typo.body2">No recipes matched your preferences. Loosen an allergy/exclude in Preferences.</MudText>
    }
    else
    {
        <MudExpansionPanels MultiExpansion="false" Class="mb-3">
            @foreach (var meal in SortedSuggestions())
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <div class="d-flex align-center">
                            <MudText>@meal.Recipe.Name</MudText>
                            <MudSpacer />
                            <MudText Typo="Typo.caption">
                                score @meal.TotalScore.ToString("0.00")@(CostLabel(meal))@(NewSpendLabel(meal))
                            </MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (meal.Reasons.Count > 0)
                        {
                            <ul class="mb-2">@foreach (var r in meal.Reasons) { <li>@r</li> }</ul>
                        }
                        <MudText Typo="Typo.caption">Ingredients</MudText>
                        <div>@foreach (var ing in meal.Recipe.Ingredients) { <MudChip T="string" Size="Size.Small">@ing</MudChip> }</div>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>

        <MudText Typo="Typo.subtitle2">Shopping list (@_plan.PlannedIngredients.Count items)</MudText>
        <MudSimpleTable Dense="true">
            <thead><tr><th style="text-align:left">Ingredient</th><th>Qty</th><th style="text-align:left">Used in</th></tr></thead>
            <tbody>
                @foreach (var ing in _plan.PlannedIngredients)
                {
                    <tr>
                        <td>
                            @ing.Name
                            @if (ing.ItemId is null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">new item</MudChip>
                            }
                            @if (ing.LikelyHave)
                            {
                                <MudTooltip Text="@(ing.LikelyHaveReason ?? "")">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-1">likely have</MudChip>
                                </MudTooltip>
                            }
                        </td>
                        <td style="text-align:center">@ing.ApproximateCount</td>
                        <td>@string.Join(", ", ing.RecipeNames)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
}

@code {
    private WeeklyPlan? _plan;
    private bool _persisted;
    private int _numRecipes = 6;
    private bool _busy;
    private string? _message;
    private Severity _messageSeverity = Severity.Info;

    private async Task SuggestAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var n = _numRecipes;
            _plan = await Task.Run(() => Planner.BuildWeeklyPlan(numRecipes: n, mapIngredients: true));
            _persisted = false; // a fresh suggestion can be added again
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { _busy = false; }
    }

    private async Task AddToListAsync()
    {
        if (_plan is null || _persisted) return;
        _busy = true;
        _message = null;
        try
        {
            // Persist the exact plan the user reviewed — do NOT rebuild (a rebuild reads the current recipe
            // count + live DB/deal state and can diverge from what's shown). _persisted guards a double-tap.
            var plan = _plan;
            await Task.Run(() => Planner.PersistToShoppingList(plan, addedBy: "Meal plan"));
            _persisted = true;
            _messageSeverity = Severity.Success;
            _message = $"Added {plan.PlannedIngredients.Count} ingredient(s) to your shopping list.";
        }
        catch (Exception ex) { Fail($"Add to list failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    private string _sortBy = "score";

    // Display-order only — PersistToShoppingList still gets the original _plan, and ingredient
    // aggregation is order-independent.
    private IEnumerable<SuggestedMeal> SortedSuggestions() =>
        _plan is null ? Array.Empty<SuggestedMeal>()
        : _sortBy == "new_spend"
            ? _plan.Suggestions.OrderBy(m => m.MarginalCostTotal ?? double.MaxValue)
            : _plan.Suggestions;

    private static string NewSpendLabel(SuggestedMeal meal) =>
        meal.MarginalCostTotal is double m && meal.NewIngredientCount is int n
            ? $" · {n} new ≈ ${m:0.00}"
            : "";

    private static string CostLabel(SuggestedMeal meal) => meal.CostPerServing is double c
        ? $" · ≈ ${c:0.00}/serving{(meal.CostKnownRatio < 1.0 ? " (partial)" : "")}"
        : "";

    private void Fail(string message)
    {
        _messageSeverity = Severity.Error;
        _message = message;
    }
}
