@page "/receipts"
@using GrocerySense.App.Services
@using GrocerySense.Core
@using GrocerySense.Data
@using GrocerySense.Data.Repositories
@using GrocerySense.Domain
@implements IDisposable
@inject ReceiptIngestionService Ingest
@inject ScanIngestService ScanIngest
@inject SqliteConnectionFactory Db
@inject IDialogService DialogService
@inject TripReconciliationService TripCheck
@inject PendingSharedReceiptsService PendingShared
@inject ItemManagerService ItemManager

<MudText Typo="Typo.h5" GutterBottom="true">Receipts</MudText>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera"
               OnClick="CaptureAndIngestAsync" Disabled="@_busy">
        Take photo
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoLibrary"
               OnClick="PickAndIngestAsync" Disabled="@_busy">
        Import from library
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PhotoLibrary"
               OnClick="BackfillImportAsync" Disabled="@_busy">
        Backfill (multiple)
    </MudButton>
    @if (_busy)
    {
        <MudButton Variant="Variant.Text" OnClick="CancelIngest">Cancel</MudButton>
        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Working" />
        <MudText Typo="Typo.caption">@(_batchProgress ?? _stage)</MudText>
    }
</MudStack>
<MudText Typo="Typo.caption" Class="mb-2">Selected receipt files are uploaded to your configured Azure OCR resource.</MudText>
<MudSwitch T="bool" @bind-Value="_replaceDuplicates" Label="Replace duplicates" Color="Color.Primary" Class="mb-2" />

@if (_message is not null)
{
    <MudAlert Class="mb-2" Severity="@_messageSeverity" Dense="true">@_message</MudAlert>
}

@* Android share target (Phase 5): receipt image(s) shared into the app land here for confirmation —
   never ingested without an explicit Import. Rejected shares (oversize/bad type/busy) are disclosed, not
   hidden. The page only PEEKS here; Import/Discard atomically claim or release the batch (P0-2). *@
@if (_sharedPaths.Count > 0 || _sharedErrors.Count > 0)
{
    <MudPaper Class="pa-3 mb-2" Outlined="true">
        @if (_sharedPaths.Count > 0)
        {
            <MudText Typo="Typo.subtitle1">@_sharedPaths.Count receipt@(_sharedPaths.Count == 1 ? "" : "s") shared into Grocery Sense</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Import now?</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ImportSharedAsync" Disabled="@_busy">Import</MudButton>
                <MudButton Variant="Variant.Text" OnClick="DiscardShared" Disabled="@_busy">Discard</MudButton>
            </MudStack>
        }
        @if (_sharedErrors.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                @_sharedErrors.Count shared item@(_sharedErrors.Count == 1 ? " was" : "s were") rejected: @string.Join("; ", _sharedErrors)
            </MudAlert>
            @if (_sharedPaths.Count == 0)
            {
                @* Error-only batch: without this, rejection notices would linger with no clearing path. *@
                <MudButton Variant="Variant.Text" OnClick="DiscardShared" Disabled="@_busy" Class="mt-1">Dismiss</MudButton>
            }
        }
    </MudPaper>
}

@if (_anyReceiptsExist || HasActiveFilter)
{
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
        <MudSelect T="int?" Value="_filterStoreId" ValueChanged="OnStoreFilterChanged" Label="Store"
                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                   Style="max-width:220px">
            <MudSelectItem T="int?" Value="@((int?)null)">All stores</MudSelectItem>
            @foreach (var store in _stores)
            {
                <MudSelectItem T="int?" Value="@((int?)store.Id)">@store.Name</MudSelectItem>
            }
        </MudSelect>
        <MudDateRangePicker Label="Date range" DateRange="_filterRange" DateRangeChanged="OnDateFilterChanged"
                            Clearable="true" Margin="Margin.Dense" Style="max-width:280px" />
    </MudStack>
}

@if (_receipts is null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" aria-label="Loading" />
    </div>
}
else if (_receipts.Count == 0)
{
    <MudText Typo="Typo.body2">
        @(_anyReceiptsExist ? "No receipts match the current filter." : "No receipts yet — import a photo above.")
    </MudText>
}
else
{
    <MudExpansionPanels MultiExpansion="false">
        @foreach (var receipt in _receipts)
        {
            <MudExpansionPanel ExpandedChanged="@(expanded => OnExpandedAsync(receipt.Id, expanded))">
                <TitleContent>
                    <MudText>
                        @receipt.PurchaseDate — @receipt.StoreName
                        @(receipt.TotalAmount is decimal t ? $" — ${t:0.00}" : "")
                        <MudText Typo="Typo.caption" Inline="true"> (@receipt.ItemCount items)</MudText>
                    </MudText>
                </TitleContent>
                <ChildContent>
                    @if (!_lines.TryGetValue(receipt.Id, out var lines))
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Loading lines" />
                    }
                    else
                    {
                        <MudSimpleTable Dense="true">
                            <thead>
                                <tr><th style="text-align:left">Item</th><th>Qty</th><th>Unit $</th><th>Total</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var line in lines)
                                {
                                    <tr>
                                        <td>
                                            @(line.CanonicalName is { Length: > 0 } cn ? cn : line.Description)
                                            @if (line.ItemId is null)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">unmapped</MudChip>
                                            }
                                        </td>
                                        <td style="text-align:center">@(line.Quantity is double q ? q.ToString("0.##") : "")</td>
                                        <td style="text-align:center">@(line.UnitPrice is decimal up ? $"{up:0.00}" : "")</td>
                                        <td style="text-align:center">@(line.LineTotal is decimal lt ? $"{lt:0.00}" : "")</td>
                                        <td style="text-align:center">
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_busy"
                                                       OnClick="@(() => CorrectMappingAsync(receipt.Id, line))">Fix</MudButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                        <MudStack Row="true" Spacing="2" Class="mt-2">
                            @if (IsRecentReceipt(receipt))
                            {
                                <MudButton Variant="Variant.Text" Disabled="@_busy"
                                           OnClick="@(() => TripCheckAsync(receipt.Id))">Trip check</MudButton>
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@_busy"
                                       OnClick="@(() => DeleteReceiptAsync(receipt))">Delete (backup kept)</MudButton>
                            @if (receipt.FilePath is { Length: > 0 } fp && CanDeleteReceiptFile(fp))
                            {
                                <MudButton Variant="Variant.Text" Disabled="@_busy"
                                           OnClick="@(() => DeleteImageAsync(receipt))">Delete image, keep data</MudButton>
                            }
                        </MudStack>
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@* Recently deleted (F01): the "backup kept" promise made actionable. Backups load on expand only;
   restore consumes the backup (repo-enforced) and discloses any dedupe conflicts. *@
<MudExpansionPanels Class="mt-4" MultiExpansion="false">
    <MudExpansionPanel Text="Recently deleted" ExpandedChanged="OnDeletedExpandedAsync">
        @if (_deletedBackups is null)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Loading backups" />
        }
        else if (_deletedBackups.Count == 0)
        {
            <MudText Typo="Typo.body2">No deleted receipts backed up.</MudText>
        }
        else
        {
            <MudList T="int" Dense="true">
                @foreach (var b in _deletedBackups)
                {
                    <MudListItem T="int">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.body2">
                                Receipt #@(b.OriginalReceiptId?.ToString() ?? "?") — deleted @(b.DeletedAt ?? "unknown")
                            </MudText>
                            <MudSpacer />
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.RestoreFromTrash" Disabled="@_busy"
                                       OnClick="@(() => RestoreDeletedAsync(b.BackupId))">Restore</MudButton>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private IReadOnlyList<ReceiptSummary>? _receipts;
    private IReadOnlyList<DeletedBackup>? _deletedBackups;
    private readonly Dictionary<int, IReadOnlyList<ReceiptLineItemRow>> _lines = new();
    private IReadOnlyList<Store> _stores = [];
    private int? _filterStoreId;
    private DateRange? _filterRange;
    private bool _anyReceiptsExist;
    private bool _busy;
    private bool _replaceDuplicates;
    private string _stage = "";
    private string? _batchProgress;
    private string? _message;
    private Severity _messageSeverity = Severity.Info;
    private CancellationTokenSource? _cts;
    private List<string> _sharedPaths = [];
    private List<string> _sharedErrors = [];

    private bool HasActiveFilter => _filterStoreId is not null || _filterRange is not null;

    // age >= 0 matters: a future-dated receipt would otherwise pass (negative age <= 7). The service
    // enforces the same window and refuses — this just keeps the button off dishonest rows.
    private static bool IsRecentReceipt(ReceiptSummary r)
    {
        if (!DateOnly.TryParse(r.PurchaseDate, out var d)) return false;
        var age = DateOnly.FromDateTime(DateTime.UtcNow).DayNumber - d.DayNumber;
        return age >= 0 && age <= TripReconciliationService.RecentTripDays;
    }

    private async Task TripCheckAsync(int receiptId)
    {
        _busy = true;
        try
        {
            var result = await Task.Run(() => TripCheck.Reconcile(receiptId));
            var parameters = new DialogParameters { ["Result"] = result };
            await DialogService.ShowAsync<TripCheckDialog>("Trip check", parameters);
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { _busy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        PendingShared.Changed += OnSharedChanged; // warm share while this page is already open
        RefreshShared();                          // cold share: MainActivity staged it before we navigated here
        try
        {
            // includeArchived: old receipts may reference a store the user has since archived.
            _stores = await Task.Run(() =>
            {
                using var conn = Db.Open();
                return StoresRepo.ListStores(conn, includeArchived: true);
            });
        }
        catch (Exception ex) { Fail(ex.Message); }
        await ReloadAsync();
    }

    private void OnSharedChanged() => _ = InvokeAsync(() => { RefreshShared(); StateHasChanged(); });

    // Peek only — rendering the banner claims nothing; the batch stays owned by the state machine until
    // the user picks Import or Discard.
    private void RefreshShared()
    {
        var (paths, errors) = PendingShared.Peek();
        _sharedPaths = [.. paths];
        _sharedErrors = [.. errors];
    }

    private async Task ReloadAsync()
    {
        try
        {
            // Snapshot filter state before the async query — the user may change it mid-reload.
            var storeId = _filterStoreId;
            var since = _filterRange?.Start is DateTime s ? s.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : null;
            var until = _filterRange?.End is DateTime e ? e.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : null;
            var hasFilter = storeId is not null || since is not null || until is not null;

            var (rows, anyExist) = await Task.Run(() =>
            {
                using var conn = Db.Open();
                var list = ReceiptsRepo.ListRecentReceipts(conn, storeId: storeId, since: since, until: until);
                // Probe unfiltered existence only when a filter hid everything — lets the empty state
                // distinguish "no receipts match" from "no receipts yet".
                var exist = list.Count > 0 || (hasFilter && ReceiptsRepo.ListRecentReceipts(conn, limit: 1).Count > 0);
                return (list, exist);
            });
            _receipts = rows;
            _anyReceiptsExist = anyExist;
            _lines.Clear();
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    private async Task OnStoreFilterChanged(int? storeId)
    {
        _filterStoreId = storeId;
        await ReloadAsync();
    }

    private async Task OnDateFilterChanged(DateRange? range)
    {
        _filterRange = range;
        await ReloadAsync();
    }

    private async Task OnExpandedAsync(int receiptId, bool expanded)
    {
        if (!expanded || _lines.ContainsKey(receiptId)) return;
        try
        {
            _lines[receiptId] = await Task.Run(() =>
            {
                using var conn = Db.Open();
                return ReceiptsRepo.ListReceiptLineItems(conn, receiptId);
            });
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    private Task PickAndIngestAsync() => AcquireAndIngestAsync("Opening library…",
        () => FilePicker.Default.PickAsync(new PickOptions
        {
            PickerTitle = "Pick a receipt photo",
            FileTypes = FilePickerFileType.Images,
        }));

    private Task CaptureAndIngestAsync()
    {
        if (!MediaPicker.Default.IsCaptureSupported)
        {
            Fail("This device can't capture photos. Use Import from library instead.");
            return Task.CompletedTask;
        }
        return AcquireAndIngestAsync("Opening camera…", () => MediaPicker.Default.CapturePhotoAsync());
    }

    // Picker/camera streams are copied into app-data before ingest; source paths may expire on Android.
    private async Task AcquireAndIngestAsync(string acquireStage, Func<Task<FileResult?>> acquire)
    {
        _busy = true;
        _message = null;
        _cts = new CancellationTokenSource();
        string? copyPath = null;
        try
        {
            _stage = acquireStage;
            var pick = await acquire();
            if (pick is null) return; // user backed out of the picker/camera

            _stage = "Copying…";
            StateHasChanged();
            copyPath = await CopyPickToAppDataAsync(pick, _cts.Token);

            _stage = "Reading receipt (OCR + parsing)…";
            StateHasChanged();
            // Single-scan workflow (A7): ingest + receipt-scoped price-alert pass, owned by ScanIngest so the
            // page, the Scan FAB and shared import share one sequence. Backfill never routes here — it must
            // not notify. An ingest failure throws (receipt uncommitted → the catch below drops the copy).
            var outcome = await ScanIngest.IngestScannedFileAsync(copyPath, _replaceDuplicates, _cts.Token);
            var ingest = outcome.Ingest;

            if (ingest.ReplaceConflict)
            {
                TryDeleteReceiptFile(copyPath); // fail-closed: nothing committed, the copy is unreferenced
                _messageSeverity = Severity.Warning;
                _message = $"Replace conflict — nothing was imported or deleted: {ingest.ConflictDetail}. " +
                           "Delete the duplicate you don't want first, then rescan.";
            }
            else if (ingest.WasDuplicate)
            {
                TryDeleteReceiptFile(copyPath); // original receipt keeps its own image
                _messageSeverity = Severity.Info;
                _message = $"Duplicate of receipt #{ingest.ReceiptId} ({ingest.DuplicateReason}) — not re-imported. " +
                           "Turn on Replace duplicates to re-ingest.";
            }
            else
            {
                // Imported — keep the image even if the alert pass failed (the receipt is committed).
                _message = ingest.ReplacedExisting
                    ? $"Receipt #{ingest.ReceiptId} imported (replaced an earlier duplicate)."
                    : $"Receipt #{ingest.ReceiptId} imported.";

                if (outcome.AlertError is not null)
                {
                    _messageSeverity = Severity.Warning;
                    _message += " · price-alert refresh failed — check Savings later.";
                }
                else
                {
                    // Alert line appended whenever alerts opened, regardless of whether the OS notification
                    // actually fired (notifications may be denied).
                    _messageSeverity = Severity.Success;
                    if (outcome.AlertsOpened > 0)
                        _message += $" · {outcome.AlertsOpened} new price alert(s) — see Savings";
                }
            }
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            TryDeleteReceiptFile(copyPath);
            _messageSeverity = Severity.Info;
            _message = "Import cancelled.";
        }
        catch (Exception ex)
        {
            TryDeleteReceiptFile(copyPath);
            Fail($"Import failed: {ex.Message}");
        }
        finally
        {
            _busy = false;
            _stage = "";
            _cts?.Dispose();
            _cts = null;
        }
    }

    // Bounded copy of a picker/camera stream into app-data. The ceiling, allowlist and destination live
    // in ReceiptFilePolicy so this page and the global Scan FAB cannot drift apart.
    private static Task<string> CopyPickToAppDataAsync(FileResult pick, CancellationToken ct) =>
        ReceiptFilePolicy.CopyPickAsync(pick, ct);

    // Backfill on-ramp: multi-pick from the gallery, copy all, then import with a per-receipt date confirm.
    // Alerts are not scanned here — correctly-dated old receipts fall outside the recent-scan window.
    private async Task BackfillImportAsync()
    {
        _busy = true;
        _message = null;
        _batchProgress = null;
        _cts = new CancellationTokenSource();
        var copied = new List<string>();
        try
        {
            _stage = "Opening library…";
            StateHasChanged();
            var picks = await FilePicker.Default.PickMultipleAsync(new PickOptions
            {
                PickerTitle = "Pick receipt photos to backfill",
                FileTypes = FilePickerFileType.Images,
            });
            var picked = picks?.Where(p => p is not null).Select(p => p!).ToList() ?? new List<FileResult>();
            if (picked.Count == 0) return; // user backed out

            // Early UX check only — the authoritative cap lives in ImportBatchAsync (service boundary).
            if (picked.Count > ReceiptIngestionService.MaxBatchFiles)
            {
                Fail($"Backfill imports are capped at {ReceiptIngestionService.MaxBatchFiles} photos per batch " +
                     $"(you picked {picked.Count}) — the backfill protocol works in chunks of 10.");
                return;
            }

            _stage = "Copying…";
            StateHasChanged();
            foreach (var pick in picked)
            {
                _cts.Token.ThrowIfCancellationRequested();
                copied.Add(await CopyPickToAppDataAsync(pick, _cts.Token));
            }

            var total = copied.Count;
            var progress = new Progress<int>(done =>
            {
                _batchProgress = $"Importing {done} / {total}…";
                InvokeAsync(StateHasChanged);
            });

            var summary = await Ingest.ImportBatchAsync(copied, ResolveDateAsync, _replaceDuplicates, progress, _cts.Token);

            // Retention: keep the copied image only for receipts that actually imported; drop the rest
            // (duplicates, skips, failures, cancellations).
            foreach (var item in summary.Items)
                if (item.Status != BatchImportStatus.Imported)
                    TryDeleteReceiptFile(item.FilePath);

            _messageSeverity = summary.Failed > 0 || summary.Conflicts > 0 ? Severity.Warning : Severity.Success;
            _message = $"Backfill done — {summary.Imported} imported, {summary.Duplicates} duplicate(s), " +
                       $"{summary.Skipped} skipped, {summary.Failed} failed" +
                       (summary.Conflicts > 0 ? $", {summary.Conflicts} replace conflict(s) — originals kept" : "") +
                       (summary.Cancelled > 0 ? $", {summary.Cancelled} cancelled" : "") + ".";
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            // Cancellation here means we stopped during the pick/copy phase (the batch itself records
            // per-file Cancelled rather than throwing) — nothing was imported yet, so drop every copy.
            foreach (var p in copied) TryDeleteReceiptFile(p);
            _messageSeverity = Severity.Info;
            _message = "Backfill cancelled.";
        }
        catch (Exception ex)
        {
            foreach (var p in copied) TryDeleteReceiptFile(p);
            Fail($"Backfill failed: {ex.Message}");
        }
        finally
        {
            _busy = false;
            _stage = "";
            _batchProgress = null;
            _cts?.Dispose();
            _cts = null;
        }
    }

    // Per-receipt date prompt for the batch. Skip / dismiss returns null so the receipt is left unimported —
    // an undated receipt is never silently stamped "today".
    private async Task<string?> ResolveDateAsync(ReceiptPrepared prepared, CancellationToken ct)
    {
        var parameters = new DialogParameters<ReceiptDateDialog>
        {
            { x => x.Merchant, prepared.Merchant },
            { x => x.Total, prepared.Total },
            { x => x.LineCount, prepared.LineCount },
            { x => x.ProposedDate, prepared.OcrDate },
            { x => x.OcrFoundDate, prepared.OcrFoundDate },
        };
        var options = new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false };
        var dialog = await DialogService.ShowAsync<ReceiptDateDialog>("Confirm purchase date", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string date } ? date : null;
    }

    // Alias-correction: re-point a mis-scanned line (and its price row) to the right item and learn the
    // description so future scans map right. Pick an existing item or create a new one.
    private async Task CorrectMappingAsync(int receiptId, ReceiptLineItemRow line)
    {
        _message = null;
        var parameters = new DialogParameters<ItemPickerDialog> { { x => x.AllowCreate, true } };
        var picker = await DialogService.ShowAsync<ItemPickerDialog>($"Fix mapping for \"{line.Description}\"", parameters);
        var picked = await picker.Result;
        if (picked is null || picked.Canceled || picked.Data is not int newItemId) return;
        if (newItemId == line.ItemId) return; // already correct

        _busy = true;
        try
        {
            // ItemManager owns the transaction; the repo loads receipt_id / description / old item_id from the
            // line row itself, so the corrected item id is all it needs.
            await Task.Run(() => ItemManager.CorrectLineMapping(line.Id, newItemId));
            _messageSeverity = Severity.Success;
            _message = $"\"{line.Description}\" now maps to the chosen item.";
            _lines.Remove(receiptId);                 // force a reload of this receipt's lines
            await OnExpandedAsync(receiptId, true);
        }
        catch (Exception ex) { Fail($"Correction failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    // Retention: the image lives beside the DB for as long as its receipt row does. Deleting the
    // receipt (backed up) or tapping delete-image removes the file — nothing is hoarded past that.
    private async Task DeleteReceiptAsync(ReceiptSummary receipt)
    {
        _busy = true;
        try
        {
            _message = null;
            await Task.Run(() =>
            {
                using var conn = Db.Open();
                ReceiptsRepo.DeleteReceiptWithBackup(conn, receipt.Id);
            });
            if (receipt.FilePath is { Length: > 0 } fp) TryDeleteReceiptFile(fp);
            _messageSeverity = Severity.Success;
            _message = $"Receipt #{receipt.Id} deleted. Rows are backed up; the image file is gone for good.";
            await ReloadAsync();
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { _busy = false; }
    }

    private async Task OnDeletedExpandedAsync(bool expanded)
    {
        if (!expanded) return;
        await ReloadDeletedBackupsAsync();
    }

    private async Task ReloadDeletedBackupsAsync()
    {
        try
        {
            _deletedBackups = await Task.Run(() =>
            {
                using var conn = Db.Open();
                return ReceiptsRepo.ListDeletedBackups(conn);
            });
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    // Restore a backed-up deletion. The repo consumes the backup in the same transaction, so a
    // double-tap can't duplicate the receipt; dedupe conflicts are disclosed, never swallowed.
    private async Task RestoreDeletedAsync(int backupId)
    {
        _busy = true;
        try
        {
            _message = null;
            var (newId, conflicts) = await Task.Run(() =>
            {
                using var conn = Db.Open();
                return ReceiptsRepo.RestoreReceiptFromBackup(conn, backupId);
            });
            _messageSeverity = conflicts.Count > 0 ? Severity.Warning : Severity.Success;
            _message = $"Receipt restored as #{newId}."
                + (conflicts.Count > 0
                    ? $" {conflicts.Count} dedupe key(s) now belong to another receipt " +
                      $"({string.Join(", ", conflicts.Select(c => c.Kind).Distinct())}) — duplicate detection may re-import it."
                    : "");
            await ReloadAsync();
            await ReloadDeletedBackupsAsync();
        }
        catch (Exception ex) { Fail($"Restore failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    private Task DeleteImageAsync(ReceiptSummary receipt)
    {
        if (receipt.FilePath is { Length: > 0 } fp)
        {
            if (TryDeleteReceiptFile(fp))
            {
                _messageSeverity = Severity.Success;
                _message = $"Image for receipt #{receipt.Id} deleted; parsed data kept.";
            }
            else Fail("Could not delete the image file.");
        }
        return Task.CompletedTask;
    }

    private static string ReceiptsDir() => ReceiptFilePolicy.ReceiptsDir();

    private static bool CanDeleteReceiptFile(string path) =>
        PathSafety.IsUnderDirectory(ReceiptsDir(), path) && File.Exists(path);

    private static bool TryDeleteReceiptFile(string? path)
    {
        if (path is null) return false;
        if (!PathSafety.IsUnderDirectory(ReceiptsDir(), path)) return false;
        try { File.Delete(path); return true; }
        catch { return false; }
    }

    // Import the shared receipt(s) the user just confirmed. Each already lives in the receipts dir (copied
    // by the share handler through the bounded policy); this is the single-scan ingest path per file, so a
    // shared receipt gets the same duplicate handling and price-alert scan as one taken in-app.
    // TryBeginImport claims the batch atomically; every exit path releases it via CompleteImport, and a
    // failure or cancel deletes the failing + remaining copies so nothing is silently hoarded.
    private async Task ImportSharedAsync()
    {
        if (!PendingShared.TryBeginImport(out var claimedPaths, out var claimedErrors)) return;
        var paths = claimedPaths;
        var rejected = claimedErrors.Count;
        _busy = true;
        _message = null;
        _cts = new CancellationTokenSource();
        int imported = 0, duplicates = 0, conflicts = 0, alerts = 0, alertFailures = 0;
        var index = 0;
        try
        {
            for (; index < paths.Count; index++)
            {
                _cts.Token.ThrowIfCancellationRequested();
                _stage = "Reading receipt (OCR + parsing)…";
                StateHasChanged();
                // Same single-scan workflow as an in-app scan. An ingest failure throws and aborts the batch
                // (caught below); an alert-pass failure does not — the receipt imported, so keep its image.
                var outcome = await ScanIngest.IngestScannedFileAsync(paths[index], _replaceDuplicates, _cts.Token);
                if (outcome.Ingest.ReplaceConflict) { conflicts++; TryDeleteReceiptFile(paths[index]); }
                else if (outcome.Ingest.WasDuplicate) { duplicates++; TryDeleteReceiptFile(paths[index]); }
                else
                {
                    imported++;
                    alerts += outcome.AlertsOpened;
                    if (outcome.AlertError is not null) alertFailures++;
                }
            }
            _messageSeverity = alertFailures > 0 || conflicts > 0 ? Severity.Warning : Severity.Success;
            _message = $"Shared import — {imported} imported, {duplicates} duplicate(s)"
                + (conflicts > 0 ? $", {conflicts} replace conflict(s) — originals kept" : "")
                + (rejected > 0 ? $", {rejected} rejected on share" : "")
                + (alerts > 0 ? $" · {alerts} new price alert(s) — see Savings" : "")
                + (alertFailures > 0 ? $" · {alertFailures} price-alert refresh(es) failed" : "") + ".";
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            // Drop the copies not yet imported when the user cancels mid-batch.
            for (var i = index; i < paths.Count; i++) TryDeleteReceiptFile(paths[i]);
            _messageSeverity = Severity.Info;
            _message = "Shared import cancelled.";
        }
        catch (Exception ex)
        {
            // Generic failure: delete the failing copy and every remaining one — a committed receipt keeps
            // its image; an uncommitted copy must not linger unowned.
            for (var i = index; i < paths.Count; i++) TryDeleteReceiptFile(paths[i]);
            Fail($"Shared import failed after {imported} import(s): {ex.Message}");
        }
        finally
        {
            PendingShared.CompleteImport();
            RefreshShared();
            _busy = false;
            _stage = "";
            _cts?.Dispose();
            _cts = null;
        }
    }

    // Discard (or dismiss an error-only batch) without importing — delete the released copies so nothing
    // is hoarded.
    private void DiscardShared()
    {
        foreach (var path in PendingShared.Discard()) TryDeleteReceiptFile(path);
        RefreshShared();
    }

    private void Fail(string message)
    {
        _messageSeverity = Severity.Error;
        _message = message;
    }

    private void CancelIngest() => _cts?.Cancel();

    public void Dispose()
    {
        PendingShared.Changed -= OnSharedChanged;
        _cts?.Cancel();
    }
}
