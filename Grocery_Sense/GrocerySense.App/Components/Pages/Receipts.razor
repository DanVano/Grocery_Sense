@page "/receipts"
@using GrocerySense.Core
@using GrocerySense.Data
@using GrocerySense.Data.Repositories
@using GrocerySense.Domain
@implements IDisposable
@inject ReceiptIngestionService Ingest
@inject SqliteConnectionFactory Db
@inject IDialogService DialogService

<MudText Typo="Typo.h5" GutterBottom="true">Receipts</MudText>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera"
               OnClick="CaptureAndIngestAsync" Disabled="@_busy">
        Take photo
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoLibrary"
               OnClick="PickAndIngestAsync" Disabled="@_busy">
        Import from library
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PhotoLibrary"
               OnClick="BackfillImportAsync" Disabled="@_busy">
        Backfill (multiple)
    </MudButton>
    @if (_busy)
    {
        <MudButton Variant="Variant.Text" OnClick="CancelIngest">Cancel</MudButton>
        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Working" />
        <MudText Typo="Typo.caption">@(_batchProgress ?? _stage)</MudText>
    }
</MudStack>
<MudSwitch T="bool" @bind-Value="_replaceDuplicates" Label="Replace duplicates" Color="Color.Primary" Class="mb-2" />

@if (_message is not null)
{
    <MudAlert Class="mb-2" Severity="@_messageSeverity" Dense="true">@_message</MudAlert>
}

@if (_receipts is null)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" aria-label="Loading" />
    </div>
}
else if (_receipts.Count == 0)
{
    <MudText Typo="Typo.body2">No receipts yet — import a photo above.</MudText>
}
else
{
    <MudExpansionPanels MultiExpansion="false">
        @foreach (var receipt in _receipts)
        {
            <MudExpansionPanel ExpandedChanged="@(expanded => OnExpandedAsync(receipt.Id, expanded))">
                <TitleContent>
                    <MudText>
                        @receipt.PurchaseDate — @receipt.StoreName
                        @(receipt.TotalAmount is decimal t ? $" — ${t:0.00}" : "")
                        <MudText Typo="Typo.caption" Inline="true"> (@receipt.ItemCount items)</MudText>
                    </MudText>
                </TitleContent>
                <ChildContent>
                    @if (!_lines.TryGetValue(receipt.Id, out var lines))
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Loading lines" />
                    }
                    else
                    {
                        <MudSimpleTable Dense="true">
                            <thead>
                                <tr><th style="text-align:left">Item</th><th>Qty</th><th>Unit $</th><th>Total</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var line in lines)
                                {
                                    <tr>
                                        <td>@(line.CanonicalName is { Length: > 0 } cn ? cn : line.Description)</td>
                                        <td style="text-align:center">@(line.Quantity is double q ? q.ToString("0.##") : "")</td>
                                        <td style="text-align:center">@(line.UnitPrice is decimal up ? $"{up:0.00}" : "")</td>
                                        <td style="text-align:center">@(line.LineTotal is decimal lt ? $"{lt:0.00}" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                        <MudStack Row="true" Spacing="2" Class="mt-2">
                            <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@_busy"
                                       OnClick="@(() => DeleteReceiptAsync(receipt))">Delete (backup kept)</MudButton>
                            @if (receipt.FilePath is { Length: > 0 } fp && CanDeleteReceiptFile(fp))
                            {
                                <MudButton Variant="Variant.Text" Disabled="@_busy"
                                           OnClick="@(() => DeleteImageAsync(receipt))">Delete image, keep data</MudButton>
                            }
                        </MudStack>
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private IReadOnlyList<ReceiptSummary>? _receipts;
    private readonly Dictionary<int, IReadOnlyList<ReceiptLineItemRow>> _lines = new();
    private bool _busy;
    private bool _replaceDuplicates;
    private string _stage = "";
    private string? _batchProgress;
    private string? _message;
    private Severity _messageSeverity = Severity.Info;
    private CancellationTokenSource? _cts;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _receipts = await Task.Run(() =>
            {
                using var conn = Db.Open();
                return ReceiptsRepo.ListRecentReceipts(conn);
            });
            _lines.Clear();
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    private async Task OnExpandedAsync(int receiptId, bool expanded)
    {
        if (!expanded || _lines.ContainsKey(receiptId)) return;
        try
        {
            _lines[receiptId] = await Task.Run(() =>
            {
                using var conn = Db.Open();
                return ReceiptsRepo.ListReceiptLineItems(conn, receiptId);
            });
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    private Task PickAndIngestAsync() => AcquireAndIngestAsync("Opening library…",
        () => FilePicker.Default.PickAsync(new PickOptions
        {
            PickerTitle = "Pick a receipt photo",
            FileTypes = FilePickerFileType.Images,
        }));

    private Task CaptureAndIngestAsync()
    {
        if (!MediaPicker.Default.IsCaptureSupported)
        {
            Fail("This device can't capture photos. Use Import from library instead.");
            return Task.CompletedTask;
        }
        return AcquireAndIngestAsync("Opening camera…", () => MediaPicker.Default.CapturePhotoAsync());
    }

    // Picker/camera streams are copied into app-data before ingest; source paths may expire on Android.
    private async Task AcquireAndIngestAsync(string acquireStage, Func<Task<FileResult?>> acquire)
    {
        _busy = true;
        _message = null;
        _cts = new CancellationTokenSource();
        string? copyPath = null;
        try
        {
            _stage = acquireStage;
            var pick = await acquire();
            if (pick is null) return; // user backed out of the picker/camera

            _stage = "Copying…";
            StateHasChanged();
            copyPath = await CopyPickToAppDataAsync(pick, _cts.Token);

            _stage = "Reading receipt (OCR + parsing)…";
            StateHasChanged();
            var outcome = await Ingest.IngestReceiptFileAsync(copyPath, _replaceDuplicates, _cts.Token);

            if (outcome.Error is { } error)
            {
                TryDeleteReceiptFile(copyPath);
                Fail($"Ingest failed: {error}");
            }
            else if (outcome.WasDuplicate)
            {
                TryDeleteReceiptFile(copyPath); // original receipt keeps its own image
                _messageSeverity = Severity.Info;
                _message = $"Duplicate of receipt #{outcome.ReceiptId} ({outcome.DuplicateReason}) — not re-imported. " +
                           "Turn on Replace duplicates to re-ingest.";
            }
            else
            {
                _messageSeverity = Severity.Success;
                _message = outcome.ReplacedExisting
                    ? $"Receipt #{outcome.ReceiptId} imported (replaced an earlier duplicate)."
                    : $"Receipt #{outcome.ReceiptId} imported.";
            }
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            TryDeleteReceiptFile(copyPath);
            _messageSeverity = Severity.Info;
            _message = "Import cancelled.";
        }
        catch (Exception ex)
        {
            TryDeleteReceiptFile(copyPath);
            Fail($"Import failed: {ex.Message}");
        }
        finally
        {
            _busy = false;
            _stage = "";
            _cts?.Dispose();
            _cts = null;
        }
    }

    // Picker/camera streams are copied into app-data (source paths can expire on Android). Returns the copy.
    private static async Task<string> CopyPickToAppDataAsync(FileResult pick, CancellationToken ct)
    {
        var dir = ReceiptsDir();
        Directory.CreateDirectory(dir);
        var ext = Path.GetExtension(pick.FileName) is { Length: > 0 } e ? e : ".jpg";
        var path = Path.Combine(dir, $"{Guid.NewGuid():N}{ext}");
        await using var src = await pick.OpenReadAsync();
        await using var dst = File.Create(path);
        await src.CopyToAsync(dst, ct);
        return path;
    }

    // Backfill on-ramp: multi-pick from the gallery, copy all, then import with a per-receipt date confirm.
    // Alerts are not scanned here — correctly-dated old receipts fall outside the recent-scan window.
    private async Task BackfillImportAsync()
    {
        _busy = true;
        _message = null;
        _batchProgress = null;
        _cts = new CancellationTokenSource();
        var copied = new List<string>();
        try
        {
            _stage = "Opening library…";
            StateHasChanged();
            var picks = await FilePicker.Default.PickMultipleAsync(new PickOptions
            {
                PickerTitle = "Pick receipt photos to backfill",
                FileTypes = FilePickerFileType.Images,
            });
            var picked = picks?.Where(p => p is not null).Select(p => p!).ToList() ?? new List<FileResult>();
            if (picked.Count == 0) return; // user backed out

            _stage = "Copying…";
            StateHasChanged();
            foreach (var pick in picked)
            {
                _cts.Token.ThrowIfCancellationRequested();
                copied.Add(await CopyPickToAppDataAsync(pick, _cts.Token));
            }

            var total = copied.Count;
            var progress = new Progress<int>(done =>
            {
                _batchProgress = $"Importing {done} / {total}…";
                InvokeAsync(StateHasChanged);
            });

            var summary = await Ingest.ImportBatchAsync(copied, ResolveDateAsync, _replaceDuplicates, progress, _cts.Token);

            // Retention: keep the copied image only for receipts that actually imported; drop the rest
            // (duplicates, skips, failures, cancellations).
            foreach (var item in summary.Items)
                if (item.Status != BatchImportStatus.Imported)
                    TryDeleteReceiptFile(item.FilePath);

            _messageSeverity = summary.Failed > 0 ? Severity.Warning : Severity.Success;
            _message = $"Backfill done — {summary.Imported} imported, {summary.Duplicates} duplicate(s), " +
                       $"{summary.Skipped} skipped, {summary.Failed} failed" +
                       (summary.Cancelled > 0 ? $", {summary.Cancelled} cancelled" : "") + ".";
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
            // Cancellation here means we stopped during the pick/copy phase (the batch itself records
            // per-file Cancelled rather than throwing) — nothing was imported yet, so drop every copy.
            foreach (var p in copied) TryDeleteReceiptFile(p);
            _messageSeverity = Severity.Info;
            _message = "Backfill cancelled.";
        }
        catch (Exception ex)
        {
            foreach (var p in copied) TryDeleteReceiptFile(p);
            Fail($"Backfill failed: {ex.Message}");
        }
        finally
        {
            _busy = false;
            _stage = "";
            _batchProgress = null;
            _cts?.Dispose();
            _cts = null;
        }
    }

    // Per-receipt date prompt for the batch. Skip / dismiss returns null so the receipt is left unimported —
    // an undated receipt is never silently stamped "today".
    private async Task<string?> ResolveDateAsync(ReceiptPrepared prepared, CancellationToken ct)
    {
        var parameters = new DialogParameters<ReceiptDateDialog>
        {
            { x => x.Merchant, prepared.Merchant },
            { x => x.Total, prepared.Total },
            { x => x.LineCount, prepared.LineCount },
            { x => x.ProposedDate, prepared.OcrDate },
            { x => x.OcrFoundDate, prepared.OcrFoundDate },
        };
        var options = new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false };
        var dialog = await DialogService.ShowAsync<ReceiptDateDialog>("Confirm purchase date", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string date } ? date : null;
    }

    // Retention: the image lives beside the DB for as long as its receipt row does. Deleting the
    // receipt (backed up) or tapping delete-image removes the file — nothing is hoarded past that.
    private async Task DeleteReceiptAsync(ReceiptSummary receipt)
    {
        _busy = true;
        try
        {
            _message = null;
            await Task.Run(() =>
            {
                using var conn = Db.Open();
                ReceiptsRepo.DeleteReceiptWithBackup(conn, receipt.Id);
            });
            if (receipt.FilePath is { Length: > 0 } fp) TryDeleteReceiptFile(fp);
            _messageSeverity = Severity.Success;
            _message = $"Receipt #{receipt.Id} deleted. Rows are backed up; the image file is gone for good.";
            await ReloadAsync();
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { _busy = false; }
    }

    private Task DeleteImageAsync(ReceiptSummary receipt)
    {
        if (receipt.FilePath is { Length: > 0 } fp)
        {
            if (TryDeleteReceiptFile(fp))
            {
                _messageSeverity = Severity.Success;
                _message = $"Image for receipt #{receipt.Id} deleted; parsed data kept.";
            }
            else Fail("Could not delete the image file.");
        }
        return Task.CompletedTask;
    }

    private static string ReceiptsDir() => Path.Combine(FileSystem.AppDataDirectory, "receipts");

    private static bool CanDeleteReceiptFile(string path) =>
        PathSafety.IsUnderDirectory(ReceiptsDir(), path) && File.Exists(path);

    private static bool TryDeleteReceiptFile(string? path)
    {
        if (path is null) return false;
        if (!PathSafety.IsUnderDirectory(ReceiptsDir(), path)) return false;
        try { File.Delete(path); return true; }
        catch { return false; }
    }

    private void Fail(string message)
    {
        _messageSeverity = Severity.Error;
        _message = message;
    }

    private void CancelIngest() => _cts?.Cancel();

    public void Dispose() => _cts?.Cancel();
}
