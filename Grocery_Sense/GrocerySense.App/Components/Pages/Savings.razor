@page "/savings"
@inherits BusyComponent
@inject WatchlistService Watchlist
@inject PriceDropAlertService Alerts
@inject ShoppingListService Shopping
@inject SmartEssentialsService Essentials
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" GutterBottom="true">Savings</MudText>

@if (_error is not null)
{
    <MudAlert Class="mb-2" Severity="Severity.Error">@_error</MudAlert>
}

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true">
    <MudTabPanel Text="Essentials">
        @* V3 F4: staples + cadence + price ladder + watches + plan links in one view. Pull-only surfacing
           (grill Q16): the Home card and this tab, no OS notifications. *@
        @if (_essentials is null)
        {
            <Loading />
        }
        else if (_essentials.Count == 0)
        {
            <MudText Typo="Typo.body2">
                No staples identified yet — essentials appear once items show up on a few receipts.
            </MudText>
        }
        else
        {
            <MudPaper Outlined="true">
                <MudList T="int" Dense="true">
                    @foreach (var e in _essentials)
                    {
                        <MudListItem T="int">
                            <div class="d-flex align-center gap-1">
                                <div>
                                    <MudText Typo="Typo.body2">
                                        <b>@e.Name</b>
                                        @if (e.DueSoon)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                                due — last bought @(e.DaysSinceLast)d ago (every ~@(e.IntervalDays)d)
                                            </MudChip>
                                        }
                                        @if (e.HasOpenAlert)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">price alert</MudChip>
                                        }
                                        @if (e.SupportsRecipes.Count > 0)
                                        {
                                            <MudTooltip Text="@string.Join(", ", e.SupportsRecipes)">
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info">in your plan</MudChip>
                                            </MudTooltip>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption">@EssentialPriceLine(e)</MudText>
                                </div>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small"
                                               OnClick="@(() => AddEssentialAsync(e))" aria-label="Add to shopping list" />
                                @if (!e.Watched)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                                   OnClick="@(() => WatchEssentialAsync(e))" aria-label="Watch price" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small"
                                               Href="@($"/meals?find={Uri.EscapeDataString(e.Name)}")"
                                               aria-label="Find meals using this" />
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
    </MudTabPanel>

    <MudTabPanel Text="Watchlist">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <MudAutocomplete T="string" @bind-Value="_pickName" Label="Item" SearchFunc="SearchItems"
                             Dense="true" Margin="Margin.Dense" CoerceText="true" MaxItems="20" />
            <MudNumericField T="double?" @bind-Value="_target" Label="Target $ (optional)" Min="0"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:160px" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync"
                       Disabled="@(_busy || string.IsNullOrWhiteSpace(_pickName))">Watch</MudButton>
        </MudStack>

        <MudText Typo="Typo.subtitle1" GutterBottom="true">Deals now</MudText>
        @if (_hits is { Count: > 0 })
        {
            <MudPaper Class="mb-3" Outlined="true">
                <MudList T="int" Dense="true">
                    @foreach (var h in _hits)
                    {
                        <MudListItem T="int">
                            <div class="d-flex align-center gap-1">
                                <MudText Typo="Typo.body2">
                                    <b>@h.ItemName</b> — $@F2(h.BestPrice) at @h.StoreName
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(h.HitReason == "target" ? Color.Primary : Color.Success)">
                                        @(h.HitReason == "target" ? "hit target" : "below usual")
                                    </MudChip>
                                    @if (h.PctBelowUsual is double p and > 0)
                                    {
                                        <span> (@p.ToString("0")% below usual)</span>
                                    }
                                </MudText>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small"
                                               OnClick="@(() => AddHitAsync(h))" aria-label="Add to shopping list" />
                                <MudIconButton Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small"
                                               Href="@($"/meals?find={Uri.EscapeDataString(h.ItemName)}")"
                                               aria-label="Find meals using this" />
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
        else
        {
            <MudText Class="mb-3" Typo="Typo.body2">No watched item is a deal right now.</MudText>
        }

        <MudText Typo="Typo.subtitle1" GutterBottom="true">Watching</MudText>
        @if (_watches is { Count: > 0 })
        {
            <MudPaper Outlined="true">
                <MudList T="int" Dense="true">
                    @foreach (var w in _watches)
                    {
                        <MudListItem T="int">
                            <div class="d-flex align-center">
                                <MudText Typo="Typo.body2">
                                    @w.ItemName
                                    @(w.TargetPrice is double t ? $" — target ${t:0.00}" : " — any good deal")
                                </MudText>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               OnClick="@(() => RemoveAsync(w.Id))" aria-label="Stop watching" />
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
        else
        {
            <MudText Typo="Typo.body2">Nothing on the watchlist yet — add an item above.</MudText>
        }
    </MudTabPanel>

    <MudTabPanel Text="Deals & Stock-up">
        @if (_alerts is null)
        {
            <Loading />
        }
        else if (_alerts.Count == 0)
        {
            <MudText Typo="Typo.body2">
                No price drops or stock-up moments right now. This grows as you import receipts and flyers.
            </MudText>
        }
        else
        {
            <MudPaper Outlined="true">
                <MudList T="int" Dense="true">
                    @foreach (var a in _alerts)
                    {
                        <MudListItem T="int">
                            <div class="d-flex align-center gap-1">
                                <div>
                                    <MudText Typo="Typo.body2">
                                        <b>@a.ItemName</b>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(a.AlertKind == "below_usual" ? Color.Success : Color.Info)">
                                            @KindLabel(a.AlertKind)
                                        </MudChip>
                                    </MudText>
                                    <MudText Typo="Typo.caption">@a.Notes</MudText>
                                    @if (a.SuggestedQtyNote is { Length: > 0 } note)
                                    {
                                        <MudText Typo="Typo.caption"><b>@note</b></MudText>
                                    }
                                </div>
                                <MudSpacer />
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                           OnClick="@(() => AddAlertAsync(a))">
                                    @(a.SuggestedQty is double sq ? $"Add to list (qty {sq:0.##})" : "Add to list")
                                </MudButton>
                                <MudIconButton Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small"
                                               Href="@($"/meals?find={Uri.EscapeDataString(a.ItemName)}")"
                                               aria-label="Find meals using this" />
                                @if (a.Id is not null)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   OnClick="@(() => DismissAsync(a))" aria-label="Dismiss alert" />
                                }
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private IReadOnlyList<SavingsWatchItem>? _watches;
    private IReadOnlyList<WatchlistHit>? _hits;
    private IReadOnlyList<PriceDropAlert>? _alerts;
    private IReadOnlyList<EssentialRow>? _essentials;
    private IReadOnlyList<(int Id, string Name)> _items = Array.Empty<(int, string)>();
    private string? _pickName;
    private double? _target;

    private static string EssentialPriceLine(EssentialRow e)
    {
        if (e.CurrentPrice is not double c) return "no current price";
        var line = $"${c:0.00} ({e.PriceSource})";
        if (e.UsualPrice is double u) line += $" · usual ${u:0.00}";
        if (e.SixMonthLow is double l) line += $" · 6-mo low ${l:0.00}";
        if (e.TargetPrice is double t) line += $" · target ${t:0.00}";
        if (e.SuggestedStockUpQty is double q) line += $" · stock up ×{q:0.##}";
        return line;
    }

    private async Task AddEssentialAsync(EssentialRow e)
    {
        var qty = e.SuggestedStockUpQty;
        await GuardAsync(() => Shopping.AddSingleItem(e.Name, quantity: qty, itemId: e.ItemId,
            addedBy: "Essentials",
            notes: e.DueSoon && e.IntervalDays is { } iv ? $"You buy this every ~{iv} day(s)" : null));
        if (_error is null) Snackbar.Add($"Added {e.Name} — see Shopping List", Severity.Success);
    }

    private async Task WatchEssentialAsync(EssentialRow e)
    {
        await GuardAsync(() => Watchlist.AddWatch(e.ItemId, null));
        await ReloadWatchlistAsync();
        await ReloadEssentialsAsync();
    }

    private async Task ReloadEssentialsAsync() =>
        _essentials = await GuardAsync(() => Essentials.BuildEssentials()) ?? Array.Empty<EssentialRow>();


    private static string KindLabel(string kind) => kind switch
    {
        "below_usual" => "price drop",
        "stock_up" => "stock up",
        "both" => "drop + stock up",
        _ => kind,
    };

    protected override async Task OnInitializedAsync()
    {
        await ReloadWatchlistAsync();
        // Refresh + load the PERSISTED open alerts — the same rows receipt-scan notifications deep-link to,
        // so a notification tap lands on the alert that fired it. Refresh is idempotent (re-derives open
        // engine rows, honors the 30-day dismissed suppression) and coexists with the SyncCompleted DI hook.
        await GuardAsync(() => Alerts.RefreshEngineAlerts(staplesOnly: true));
        await ReloadAlertsAsync();
        await ReloadEssentialsAsync();
    }

    private async Task ReloadAlertsAsync() =>
        _alerts = await GuardAsync(() => Alerts.GetAlerts()) ?? Array.Empty<PriceDropAlert>();

    private async Task DismissAsync(PriceDropAlert alert)
    {
        if (alert.Id is not int id) return; // only persisted rows are dismissible
        await GuardAsync(() => Alerts.DismissAlert(id));
        await ReloadAlertsAsync();
    }

    private Task<IEnumerable<string>> SearchItems(string value, CancellationToken ct)
    {
        var q = (value ?? "").Trim();
        var matches = _items
            .Where(i => q.Length == 0 || i.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Select(i => i.Name);
        return Task.FromResult(matches);
    }

    private async Task AddAsync()
    {
        var itemId = _items.FirstOrDefault(i =>
            string.Equals(i.Name, _pickName, StringComparison.OrdinalIgnoreCase)).Id;
        if (itemId <= 0) { _error = "Pick an item from the list."; return; }

        var target = _target;
        await GuardAsync(() => Watchlist.AddWatch(itemId, target));
        _pickName = null;
        _target = null;
        await ReloadWatchlistAsync();
    }

    private async Task RemoveAsync(int watchId)
    {
        await GuardAsync(() => Watchlist.RemoveWatch(watchId));
        await ReloadWatchlistAsync();
    }

    // Add an alert's item (with its suggested stock-up qty when present) to the active list. Adding isn't the
    // same as acting on it in-store, so the card stays open — the user dismisses it explicitly when done.
    private async Task AddAlertAsync(PriceDropAlert alert)
    {
        await GuardAsync(() => Shopping.AddAlertToList(alert));
        if (_error is null) Snackbar.Add($"Added {alert.ItemName} — see Shopping List", Severity.Success);
    }

    // Add a watch hit to the list (F04) — mapped, planned at the hit's store, price in the note.
    private async Task AddHitAsync(WatchlistHit hit)
    {
        await GuardAsync(() => Shopping.AddWatchHitToList(hit));
        if (_error is null) Snackbar.Add($"Added {hit.ItemName} — see Shopping List", Severity.Success);
    }

    private async Task ReloadWatchlistAsync()
    {
        _items = await GuardAsync(() => Watchlist.ListWatchableItems()) ?? Array.Empty<(int, string)>();
        _watches = await GuardAsync(() => Watchlist.ListWatches()) ?? Array.Empty<SavingsWatchItem>();
        _hits = await GuardAsync(() => Watchlist.ComputeHits()) ?? Array.Empty<WatchlistHit>();
    }
}
