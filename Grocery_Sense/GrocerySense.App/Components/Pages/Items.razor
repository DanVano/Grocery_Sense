@page "/items"
@inherits BusyComponent
@inject SqliteConnectionFactory Db
@inject IDialogService DialogService
@inject ItemManagerService ItemManager
@inject PriceHistoryService PriceHistory

<MudText Typo="Typo.h5" GutterBottom="true">Items</MudText>
<MudText Typo="Typo.body2" Class="mb-2">
    Merge duplicates and rename mis-scanned items. Merging moves all price history onto the target and keeps
    the old name as an alias.
</MudText>

<MudTextField @bind-Value="_query" Immediate="true" DebounceInterval="250" OnDebounceIntervalElapsed="OnSearch"
              Placeholder="Search items…" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
              Class="mb-2" />

@if (_message is not null)
{
    <MudAlert Class="mb-2" Severity="@_messageSeverity" Dense="true">@_message</MudAlert>
}

@if (_items is null)
{
    <Loading />
}
else if (_items.Count == 0)
{
    <MudText Typo="Typo.body2">No items@(string.IsNullOrWhiteSpace(_query) ? " yet — scan a receipt first." : " match that search.")</MudText>
}
else
{
    <MudExpansionPanels MultiExpansion="false">
        @foreach (var item in _items)
        {
            <MudExpansionPanel ExpandedChanged="@(e => OnExpandedAsync(item.Id, e))">
                <TitleContent>
                    <div class="d-flex align-center">
                        <MudText>@item.CanonicalName</MudText>
                        @if (!item.IsTracked)
                        {
                            <MudChip T="string" Size="Size.Small" Class="ml-2" Color="Color.Default">untracked</MudChip>
                        }
                        @if (item.Category is { Length: > 0 } cat)
                        {
                            <MudChip T="string" Size="Size.Small" Class="ml-2" Color="Color.Info">@cat</MudChip>
                        }
                        <MudSpacer />
                        <MudText Typo="Typo.caption">
                            @item.PricePoints price@(item.PricePoints == 1 ? "" : "s")@(item.LastPriceDate is { } d ? $" · last {d}" : "")
                        </MudText>
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (_renamingId == item.Id)
                    {
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudTextField @bind-Value="_renameText" Label="New name" Immediate="true" />
                            <MudButton Color="Color.Primary" Disabled="@_busy" OnClick="@(() => SaveRenameAsync(item))">Save</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="@(() => _renamingId = null)">Cancel</MudButton>
                        </MudStack>
                    }

                    @if (!_aliases.TryGetValue(item.Id, out var aliases))
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Loading aliases" />
                    }
                    else if (aliases.Count > 0)
                    {
                        <MudText Typo="Typo.caption">Also known as</MudText>
                        <div class="mb-2">
                            @foreach (var a in aliases)
                            {
                                <MudChip T="string" Size="Size.Small">@a.AliasText</MudChip>
                            }
                        </div>
                    }

                    @* Price history (F02): the actual points behind the "N prices" count. Thin history is
                       honest — stats only when the window has samples, no fabricated usual. *@
                    @if (_profiles.TryGetValue(item.Id, out var profile))
                    {
                        @if (profile.SampleCount == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">
                                No price history in the last @profile.WindowDays days.
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="d-block">
                                Last @profile.WindowDays days: @profile.SampleCount price point(s)
                                @(profile.UsualPrice is double u ? $" · usual ${u:0.00} ({profile.UsualBasis.Replace('_', ' ')}, {profile.UsualSamples} samples)" : " · not enough samples for a usual price")
                                @(profile.MinPrice is double mn && profile.MaxPrice is double mx ? $" · range ${mn:0.00}–${mx:0.00}" : "")
                            </MudText>
                            <MudSimpleTable Dense="true" Class="mb-2">
                                <thead>
                                    <tr><th style="text-align:left">Date</th><th style="text-align:left">Store</th>
                                        <th style="text-align:right">Price</th><th style="text-align:left">Source</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in profile.Points)
                                    {
                                        <tr>
                                            <td>@p.Date</td>
                                            <td>@p.StoreName</td>
                                            <td style="text-align:right">$@p.UnitPrice.ToString("0.00")@(p.Unit is { Length: > 0 } pu ? $"/{pu}" : "")</td>
                                            <td>@p.Source</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    }

                    @* Category editor (V3 finding 6): the swap coverage note pointed here; now the editor
                       exists. Categories power same-category swaps only — never nutrition inference. *@
                    @if (_categoryEditId == item.Id)
                    {
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudAutocomplete T="string" @bind-Value="_categoryText" Label="Category"
                                             SearchFunc="SearchCategoriesAsync" CoerceValue="true" Clearable="true"
                                             Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:260px"
                                             HelperText="Groups items for cheaper-swap suggestions" />
                            <MudButton Color="Color.Primary" Disabled="@_busy"
                                       OnClick="@(() => SaveCategoryAsync(item))">Save</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="@(() => _categoryEditId = null)">Cancel</MudButton>
                        </MudStack>
                    }

                    <MudStack Row="true" Spacing="2">
                        <MudButton StartIcon="@Icons.Material.Filled.Edit" Disabled="@_busy"
                                   OnClick="@(() => StartRename(item))">Rename</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.Label" Disabled="@_busy"
                                   OnClick="@(() => StartCategoryEdit(item))">Category</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.Merge" Color="Color.Secondary" Disabled="@_busy"
                                   OnClick="@(() => MergeIntoAsync(item))">Merge into…</MudButton>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private IReadOnlyList<ItemAdminRow>? _items;
    private readonly Dictionary<int, IReadOnlyList<ItemAlias>> _aliases = new();
    private readonly Dictionary<int, ItemPriceProfile> _profiles = new();
    private string _query = "";
    private int? _renamingId;
    private string _renameText = "";

    protected override Task OnInitializedAsync() => SearchAsync();

    private Task OnSearch(string value) => SearchAsync();

    private async Task SearchAsync()
    {
        try
        {
            var q = _query;
            _items = await Task.Run(() =>
            {
                using var conn = Db.Open();
                return ItemsAdminRepo.SearchItems(conn, q);
            });
            _aliases.Clear();
            _profiles.Clear();
            _renamingId = null;
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    private async Task OnExpandedAsync(int itemId, bool expanded)
    {
        if (!expanded || _aliases.ContainsKey(itemId)) return;
        try
        {
            var (aliases, profile) = await Task.Run(() =>
            {
                using var conn = Db.Open();
                return (ItemAliasesRepo.ListByItem(conn, itemId),
                        PriceHistory.GetItemPriceProfile(itemId));
            });
            _aliases[itemId] = aliases;
            _profiles[itemId] = profile;
        }
        catch (Exception ex) { Fail(ex.Message); }
    }

    private void StartRename(ItemAdminRow item)
    {
        _message = null;
        _renamingId = item.Id;
        _renameText = item.CanonicalName;
    }

    private int? _categoryEditId;
    private string _categoryText = "";

    private void StartCategoryEdit(ItemAdminRow item)
    {
        _message = null;
        _categoryEditId = item.Id;
        _categoryText = item.Category ?? "";
    }

    private async Task<IEnumerable<string>> SearchCategoriesAsync(string value, CancellationToken ct)
    {
        var q = (value ?? "").Trim();
        return await Task.Run(() =>
        {
            using var conn = Db.Open();
            var all = ItemsAdminRepo.ListDistinctCategories(conn);
            return (IEnumerable<string>)(q.Length == 0 ? all
                : all.Where(c => c.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList());
        }, ct);
    }

    private async Task SaveCategoryAsync(ItemAdminRow item)
    {
        _busy = true;
        try
        {
            var cat = _categoryText;
            await Task.Run(() =>
            {
                using var conn = Db.Open();
                ItemsAdminRepo.SetItemCategory(conn, item.Id, cat);
            });
            _categoryEditId = null;
            _messageSeverity = Severity.Success;
            _message = string.IsNullOrWhiteSpace(cat)
                ? $"Category cleared for \"{item.CanonicalName}\"."
                : $"\"{item.CanonicalName}\" categorized as \"{cat.Trim()}\".";
            await SearchAsync();
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { _busy = false; }
    }

    private async Task SaveRenameAsync(ItemAdminRow item)
    {
        _busy = true;
        try
        {
            var name = _renameText;
            await Task.Run(() =>
            {
                using var conn = Db.Open();
                ItemsAdminRepo.RenameItem(conn, item.Id, name);
            });
            _renamingId = null;
            _messageSeverity = Severity.Success;
            _message = $"Renamed to \"{name.Trim()}\".";
            await SearchAsync();
        }
        catch (InvalidOperationException ex) { Fail(ex.Message); }   // name collision — clear message
        catch (Exception ex) { Fail(ex.Message); }
        finally { _busy = false; }
    }

    private async Task MergeIntoAsync(ItemAdminRow source)
    {
        _message = null;
        var parameters = new DialogParameters<ItemPickerDialog>
        {
            { x => x.AllowCreate, false },
            { x => x.ExcludeItemId, source.Id },
        };
        var picker = await DialogService.ShowAsync<ItemPickerDialog>($"Merge \"{source.CanonicalName}\" into…", parameters);
        var picked = await picker.Result;
        if (picked is null || picked.Canceled || picked.Data is not int targetId) return;

        var targetName = await Task.Run(() =>
        {
            using var conn = Db.Open();
            return ItemsRepo.GetItemById(conn, targetId)?.CanonicalName ?? "the selected item";
        });

        var ok = await DialogService.ShowMessageBoxAsync("Merge items?",
            $"\"{source.CanonicalName}\" will be deleted and its price history moved into \"{targetName}\". " +
            "The old name is kept as an alias. This can't be undone.",
            yesText: "Merge", cancelText: "Cancel");
        if (ok != true) return;

        _busy = true;
        try
        {
            // ItemManager owns the transaction and drops the mapper's cached fuzzy-choice list after the merge
            // (the source item id is gone; a later scan must not fuzzy-match it and abort ingest on an FK fail).
            await Task.Run(() => ItemManager.MergeItems(targetId, source.Id));
            _messageSeverity = Severity.Success;
            _message = $"Merged \"{source.CanonicalName}\" into \"{targetName}\".";
            await SearchAsync();
        }
        catch (Exception ex) { Fail($"Merge failed: {ex.Message}"); }
        finally { _busy = false; }
    }

}
