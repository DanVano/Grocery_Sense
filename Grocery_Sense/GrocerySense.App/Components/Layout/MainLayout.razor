@inherits LayoutComponentBase
@implements IDisposable
@inject AppStartup Startup
@inject DbMaintenanceService Maintenance
@inject FamilyRequestsService Family
@inject NavigationManager Nav
@inject PendingNavigationService PendingNav
@inject QuickScanService QuickScan
@inject ISnackbar Snackbar

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" aria-label="Open navigation" />
        <MudText Typo="Typo.h6" Class="ml-2">Grocery Sense</MudText>
    </MudAppBar>

    @* Drawer is now the "More" overflow: the long-tail destinations. The five daily ones
       (Home, Deals, List, Receipts) live in the bottom bar; this holds the rest. *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudNavLink Href="/items" Icon="@Icons.Material.Filled.Category">Items</MudNavLink>
            <MudNavLink Href="/stores" Icon="@Icons.Material.Filled.Storefront">Stores</MudNavLink>
            <MudNavLink Href="/plan" Icon="@Icons.Material.Filled.Route">Plan</MudNavLink>
            <MudNavLink Href="/meals" Icon="@Icons.Material.Filled.Restaurant">Meals</MudNavLink>
            <MudNavLink Href="/family" Icon="@Icons.Material.Filled.Groups">
                <div class="d-flex align-center">
                    Family
                    @if (_familyCount > 0)
                    {
                        <MudBadge Content="_familyCount" Color="Color.Error" Overlap="false" Class="ml-3" />
                    }
                </div>
            </MudNavLink>
            <MudNavLink Href="/compare" Icon="@Icons.Material.Filled.Balance">Compare</MudNavLink>
            <MudNavLink Href="/budget" Icon="@Icons.Material.Filled.Savings">Budget</MudNavLink>
            <MudNavLink Href="/savings" Icon="@Icons.Material.Filled.TrendingDown">Savings</MudNavLink>
            <MudNavLink Href="/preferences" Icon="@Icons.Material.Filled.Settings">Preferences</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        @* pa-4 for the sides; extra bottom padding (inline !important to beat pa-4's) so the last
           row clears the fixed bottom bar, plus the Android gesture-bar safe-area inset. *@
        <div class="pa-4" style="padding-bottom: calc(80px + env(safe-area-inset-bottom, 0px)) !important;">
            @if (Startup.Status == StartupStatus.Ready)
            {
                @Body
            }
            else if (Startup.Status == StartupStatus.Error)
            {
                @* P1-5 recovery shell: Preferences is unreachable when startup fails, so the recovery
                   controls must live here. Restore stages a validated backup; the swap happens on the
                   next startup (retry completes it without killing the process). *@
                <MudAlert Severity="Severity.Error">Database failed to initialize: @Startup.Error</MudAlert>
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_recoveryBusy"
                               OnClick="RetryStartupAsync">Retry</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="@_recoveryBusy"
                               OnClick="RestoreFromBackupAsync">Restore from backup</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="@_recoveryBusy"
                               OnClick="ExportDiagnosticsAsync">Export diagnostics</MudButton>
                </MudStack>
                @if (_recoveryMessage is not null)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">@_recoveryMessage</MudText>
                }
            }
            else
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" aria-label="Loading" />
                </div>
            }
        </div>
    </MudMainContent>

    @* Global Scan FAB (Phase 2c): receipt capture is one tap from every screen, not buried in the
       Receipts page. Turns into a spinner while the OCR round-trip runs. *@
    @if (Startup.Status == StartupStatus.Ready)
    {
        <div style="position:fixed; right:16px; z-index:1300;
                    bottom: calc(88px + env(safe-area-inset-bottom, 0px));">
            @if (_scanning)
            {
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" aria-label="Reading receipt" />
            }
            else
            {
                <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PhotoCamera"
                        OnClick="ScanReceiptAsync" aria-label="Scan a receipt" />
            }
        </div>
    }

    @* Bottom navigation (Phase 2a): daily destinations one tap away. Trip-prep order — Deals is the
       headline. Long tail sits behind More (the drawer). Only rendered once the shell is Ready so it
       never floats over the loading/error state. *@
    @if (Startup.Status == StartupStatus.Ready)
    {
        <MudAppBar Bottom="true" Dense="true" Elevation="8"
                   Style="padding-bottom: env(safe-area-inset-bottom, 0px);">
            <div class="d-flex align-center" style="width:100%; gap:2px;">
                @NavItem("/", Icons.Material.Filled.Home, "Home")
                @NavItem("/deals", Icons.Material.Filled.LocalOffer, "Deals")
                @NavItem("/list", Icons.Material.Filled.Checklist, "List")
                @NavItem("/receipts", Icons.Material.Filled.ReceiptLong, "Receipts")
                <MudButton OnClick="ToggleDrawer" Variant="Variant.Text" Color="Color.Inherit"
                           Style="min-width:0; flex:1;" aria-label="More destinations">
                    <div class="d-flex flex-column align-center" style="line-height:1.1;">
                        <MudIcon Icon="@Icons.Material.Filled.Menu" Size="Size.Medium" />
                        <MudText Typo="Typo.caption">More</MudText>
                    </div>
                </MudButton>
            </div>
        </MudAppBar>
    }
</MudLayout>

@code {
    private bool _drawerOpen;
    private int _familyCount;
    private bool _scanning;
    private bool _recoveryBusy;
    private string? _recoveryMessage;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // ---- P1-5 startup-error recovery ----

    private async Task RetryStartupAsync()
    {
        _recoveryBusy = true;
        _recoveryMessage = null;
        try { await Startup.RetryAsync(); }
        finally { _recoveryBusy = false; }
        StateHasChanged();
    }

    // Stage a picked backup for the cold-start swap, then retry startup — the retry completes the swap
    // (no DB consumer exists yet in the Error state) and runs migrations on the restored file.
    private async Task RestoreFromBackupAsync()
    {
        _recoveryBusy = true;
        _recoveryMessage = null;
        string? copied = null;
        try
        {
            var pick = await FilePicker.Default.PickAsync(new PickOptions { PickerTitle = "Pick a Grocery Sense backup (.db)" });
            if (pick is null) return; // user backed out

            // Copy the picked stream into the cache first — validation needs a real local file.
            copied = Path.Combine(FileSystem.CacheDirectory, $"restore_candidate_{Guid.NewGuid():N}.db");
            await using (var source = await pick.OpenReadAsync())
            await using (var dest = File.Create(copied))
                await source.CopyToAsync(dest);

            await Task.Run(() => Maintenance.StageRestore(copied));
            _recoveryMessage = "Backup validated and staged — retrying startup with the restored database…";
            StateHasChanged();
            await Startup.RetryAsync();
        }
        catch (Exception ex)
        {
            _recoveryMessage = $"Restore failed: {ex.Message}";
        }
        finally
        {
            if (copied is not null) { try { File.Delete(copied); } catch { /* cache cleanup is best-effort */ } }
            _recoveryBusy = false;
            StateHasChanged();
        }
    }

    private async Task ExportDiagnosticsAsync()
    {
        _recoveryBusy = true;
        try
        {
            var path = Path.Combine(FileSystem.CacheDirectory, "grocery_sense_diagnostics.txt");
            await File.WriteAllTextAsync(path,
                $"Grocery Sense startup diagnostics ({DateTime.UtcNow:o})\nStatus: {Startup.Status}\nError: {Startup.Error}\n");
            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Grocery Sense diagnostics",
                File = new ShareFile(path),
            });
        }
        catch (Exception ex)
        {
            _recoveryMessage = $"Could not export diagnostics: {ex.Message}";
        }
        finally { _recoveryBusy = false; }
    }

    // Global one-tap capture. Every outcome is reported: a failure says so verbatim, a duplicate says
    // it was already imported, and a success links through to the receipt. Silence is only correct
    // when the user backed out of the camera themselves.
    private async Task ScanReceiptAsync()
    {
        _scanning = true;
        StateHasChanged();
        try
        {
            var result = await QuickScan.CaptureAndIngestAsync();

            if (result.Error is { } error)
            {
                Snackbar.Add($"Scan failed: {error}", Severity.Error);
                return;
            }
            if (!result.Captured) return; // user backed out of the camera

            if (result.WasDuplicate)
            {
                Snackbar.Add($"Already imported as receipt #{result.ReceiptId}.", Severity.Info);
                return;
            }

            // Imported, but the post-commit alert pass failed: the receipt (and image) stand — say so honestly,
            // not "scan failed". Still link through to the receipt.
            if (result.AlertError is not null)
            {
                Snackbar.Add($"Receipt #{result.ReceiptId} imported — price-alert refresh failed.", Severity.Warning, config =>
                {
                    config.Action = "View";
                    config.ActionColor = Color.Primary;
                    config.OnClick = _ => { Nav.NavigateTo("/receipts"); return Task.CompletedTask; };
                });
                return;
            }

            var message = $"Receipt #{result.ReceiptId} imported"
                + (result.AlertsOpened > 0 ? $" · {result.AlertsOpened} new price alert(s)" : "");
            Snackbar.Add(message, Severity.Success, config =>
            {
                config.Action = "View";
                config.ActionColor = Color.Primary;
                config.OnClick = _ => { Nav.NavigateTo("/receipts"); return Task.CompletedTask; };
            });
        }
        finally { _scanning = false; }
    }

    // A bottom-bar destination: icon over label, tinted primary when it's the current route.
    // Href navigation fires LocationChanged, which restyles the active item (see OnLocationChanged).
    private RenderFragment NavItem(string href, string icon, string label) =>
        @<MudButton Href="@href" Variant="Variant.Text"
                    Color="@(IsActive(href) ? Color.Primary : Color.Inherit)"
                    Style="min-width:0; flex:1;">
            <div class="d-flex flex-column align-center" style="line-height:1.1;">
                <MudIcon Icon="@icon" Size="Size.Medium" />
                <MudText Typo="Typo.caption">@label</MudText>
            </div>
        </MudButton>;

    // Active when the current relative path equals the target ("" == Home). Prefix match would light
    // up siblings, so this is an exact compare.
    private bool IsActive(string href)
    {
        var target = href.Trim('/');
        var cur = Nav.ToBaseRelativePath(Nav.Uri);
        var q = cur.IndexOf('?');
        if (q >= 0) cur = cur[..q];
        cur = cur.TrimEnd('/');
        return target.Length == 0
            ? cur.Length == 0
            : cur.Equals(target, StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnInitialized()
    {
        Startup.Changed += OnStartupChanged;
        Nav.LocationChanged += OnLocationChanged;
        PendingNav.RouteSet += OnPendingRouteSet; // warm notification tap
        _ = Startup.EnsureStartedAsync();
    }

    private void OnStartupChanged()
    {
        RefreshFamilyBadge();
        ConsumePendingRoute(); // cold start: a notification-tap route was captured before Blazor was up
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnPendingRouteSet() => _ = InvokeAsync(ConsumePendingRoute);

    // Navigate to a route captured from a notification tap (deep link, A7). Only once the shell is ready.
    private void ConsumePendingRoute()
    {
        if (Startup.Status != StartupStatus.Ready) return; // still pending; drained on the Ready transition
        if (PendingNav.TakePendingRoute() is { Length: > 0 } route) Nav.NavigateTo(route);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        RefreshFamilyBadge();
        _ = InvokeAsync(StateHasChanged);
    }

    // Best-effort unreviewed-pick badge, refreshed on navigation. Only once the DB is ready; swallow errors
    // (a stale/absent badge must never break the shell).
    private void RefreshFamilyBadge()
    {
        if (Startup.Status != StartupStatus.Ready) return;
        _ = Task.Run(() =>
        {
            try { var n = Family.UnreviewedCount(); _familyCount = n; _ = InvokeAsync(StateHasChanged); }
            catch { /* badge is non-critical */ }
        });
    }

    public void Dispose()
    {
        Startup.Changed -= OnStartupChanged;
        Nav.LocationChanged -= OnLocationChanged;
        PendingNav.RouteSet -= OnPendingRouteSet;
    }
}
